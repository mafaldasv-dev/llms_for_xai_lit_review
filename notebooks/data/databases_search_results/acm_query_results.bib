@inproceedings{10.1145/3766671.3766879,
  abstract = {Accurate traffic flow forecasting is crucial for intelligent transportation systems, aiming to alleviate congestion and optimize infrastructure planning. However, traditional methods have difficulty modeling intricate spatial-temporal relationships and model non-Euclidean spatial data. A new framework is presented in this study, Heterogeneous Attention-based Large Language Model (HALLM), leveraging large language models (LLMs) to improve prediction accuracy in dynamic traffic networks. Specifically, We introduce a spatio-temporal embedding module capable of capturing both spatial and temporal patterns. and employ a heterogeneous attention mechanism to model temporal and spatial dependencies separately. Our approach utilizes fine-tuning techniques to effectively capture these dependencies. Experiments performed on real-world datasets (CHBike and NYCTaxi) demonstrate that HALLM outperforms existing models in terms of prediction accuracy, convergence speed, and robustness. Notably, HALLM achieves 5% reduction in RMSE compared to the best-performing baseline, highlighting the potential of LLMs for addressing spatial-temporal data challenges in traffic forecasting.},
  address = {New York, NY, USA},
  author = {Chen, Rongyan and Lu, Liyang and Jin, Haoyu and Gu, Xinyu},
  booktitle = {Proceedings of the 9th International Conference on Electronic Information Technology and Computer Engineering},
  doi = {10.1145/3766671.3766879},
  isbn = {9798400714047},
  keywords = {graph neural networks, heterogeneous attention, large language model, spatial-temporal embedding, traffic flow forecasting},
  location = {},
  numpages = {7},
  pages = {1203–1209},
  publisher = {Association for Computing Machinery},
  series = {EITCE '25},
  title = {HALLM: Heterogeneous Attention-based Large Language Model for Traffic Flow Prediction},
  url = {https://doi.org/10.1145/3766671.3766879},
  year = {2025}
}

@article{10.1145/3766900,
  abstract = {Explainable Artificial Intelligence (XAI) aims to uncover the inner reasoning of machine learning models. In IoT systems, XAI improves the transparency of models processing sensor data from multiple heterogeneous devices, ensuring end-users understand and trust their outputs. Among the many applications, XAI has also been applied to sensor-based Activities of Daily Living (ADLs) recognition in smart homes. Existing approaches highlight which sensor events are most important for each predicted activity, using simple rules to convert these events into natural language explanations for non-expert users. However, these methods produce rigid explanations lacking natural language flexibility and are not scalable. With the recent rise of Large Language Models (LLMs), it is worth exploring whether they can enhance explanation generation, considering their proven knowledge of human activities. This article investigates potential approaches to combine XAI and LLMs for sensor-based ADL recognition. We evaluate if LLMs can be used: (a) as explainable zero-shot ADL recognition models, avoiding costly labeled data collection, and (b) to automate the generation of explanations for existing data-driven XAI approaches when training data is available and the goal is higher recognition rates. Our critical evaluation provides insights into the benefits and challenges of using LLMs for explainable ADL recognition.},
  address = {New York, NY, USA},
  articleno = {24},
  author = {Fiori, Michele and Civitarese, Gabriele and Choudhary, Priyankar and Bettini, Claudio},
  doi = {10.1145/3766900},
  issue_date = {November 2025},
  journal = {ACM Trans. Internet Things},
  keywords = {Smart homes, human activity recognition, XAI, LLMs},
  month = {November},
  number = {4},
  numpages = {25},
  publisher = {Association for Computing Machinery},
  title = {Leveraging Large Language Models for Explainable Activity Recognition in Smart Homes: A Critical Evaluation},
  url = {https://doi.org/10.1145/3766900},
  volume = {6},
  year = {2025}
}

@inproceedings{10.1145/3766918.3766939,
  abstract = {Novelty assessment is a cornerstone of technological innovation and intellectual property protection, profoundly influencing national technology strategies and economic development. Traditional evaluation models, which rely on domain experts, face significant challenges, including subjectivity, inconsistency, and low efficiency. These issues are exacerbated by the surging volume of global patent applications. While generative AI technologies, particularly Large Language Models (LLMs), offer promising avenues for automation, their prevalent use of implicit reasoning often leads to "hallucinations" and weak discrimination capabilities, rendering them unsuitable for the logically rigorous task of patent novelty assessment. To address this gap, this paper introduces TCL-MFSNE (Temporal-Contrastive Learning Multi-Agent Framework with Byzantine Consensus for Scientific Novelty Evaluation), an advanced multi-agent framework designed to systematically enhance the accuracy, robustness, and interpretability of evaluations. The core of TCL-MFSNE rests on three pillars: (1) Explicit Chain-of-Thought (CoT) Reasoning, which guides the model to generate detailed, transparent reasoning steps, overcoming the black-box nature of implicit reasoning. (2) Two-Dimensional Contrastive Learning, which includes "Positive-Negative Contrastive Learning" to sharpen the model's ability to discern key novel features by learning from paired authorized and unauthorized patents, and "Temporal Contrastive Learning" to ensure evaluations are accurately contextualized within the historical technological landscape. (3) Byzantine Consensus Mechanism, which leverages multiple heterogeneous LLM agents for independent evaluations and employs a consensus algorithm to filter out individual agent errors or biases, ensuring a stable and reliable final decision. We conducted comprehensive experiments on a real-world dataset of patents filed between 2008 and 2024. The results demonstrate that the TCL-MFSNE framework achieves an accuracy and F1-score of 85%, significantly outperforming baseline models such as implicit LLMs, single-agent systems, and other ablation variants. This research not only provides a viable solution for automated patent novelty assessment but also offers a new paradigm for applying generative AI to other professional domains that demand high precision and strong logical coherence.},
  address = {New York, NY, USA},
  author = {Zheng, Lin and Xu, Qingyu and Ma, Jian and Wang, Yong},
  booktitle = {Proceedings of the 2025 International Conference on Generative Artificial Intelligence for Business},
  doi = {10.1145/3766918.3766939},
  isbn = {9798400716027},
  keywords = {Large Language Models, Multiagent Systems, Novelty Evaluation, Patent Evaluation},
  location = {},
  numpages = {6},
  pages = {121–126},
  publisher = {Association for Computing Machinery},
  series = {GAIB '25},
  title = {TCLMA: A Two-dimension Contrastive Learning based Multiagent Framework for Scientific Novelty Evaluation},
