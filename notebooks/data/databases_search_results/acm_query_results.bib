  year = {2025}
}

@inproceedings{10.1145/3766918.3766948,
  abstract = {With the proliferation of Large Language Models (LLMs), the detection of misinformation has become increasingly important and complex. This research proposes an innovative verifiable misinformation detection LLM agent that goes beyond traditional true/false binary judgments. The agent actively verifies claims through dynamic interaction with diverse web sources, assesses information source credibility, synthesizes evidence, and provides a complete verifiable reasoning process. Our designed agent architecture includes three core tools: precise web search tool, source credibility assessment tool and numerical claim verification tool. These tools enable the agent to execute multi-step verification strategies, maintain evidence logs, and form comprehensive assessment conclusions. We evaluate using standard misinformation datasets such as FakeNewsNet, comparing with traditional machine learning models and LLMs. Evaluation metrics include standard classification metrics, quality assessment of reasoning processes, and robustness testing against rewritten content. Experimental results show that our agent outperforms baseline methods in misinformation detection accuracy, reasoning transparency, and resistance to information rewriting, providing a new paradigm for trustworthy AI-assisted fact-checking.},
  address = {New York, NY, USA},
  author = {Cui, Zikun and Huang, Tianyi and Chiang, Chia-En and Du, Cuiqianhe},
  booktitle = {Proceedings of the 2025 International Conference on Generative Artificial Intelligence for Business},
  doi = {10.1145/3766918.3766948},
  isbn = {9798400716027},
  keywords = {LLM Agent, Misinformation Detection, Verifiable Reasoning},
  location = {},
  numpages = {7},
  pages = {179–185},
  publisher = {Association for Computing Machinery},
  series = {GAIB '25},
  title = {Toward Verifiable Misinformation Detection: A Multi-Tool LLM Agent Framework},
  url = {https://doi.org/10.1145/3766918.3766948},
  year = {2025}
}

@inproceedings{10.1145/3766918.3766959,
  abstract = {Online consumer sentiment plays a critical role in shaping brand perception, yet extracting meaningful insights from unstructured data remains challenging. This study proposes a transformer-based sentiment analysis framework using BERT and RoBERTa to interpret consumer opinions from Twitter, Amazon, and Yelp. The objective is to evaluate model performance in sentiment classification and demonstrate its utility in informing brand positioning strategies. Fine-tuned models achieved high classification accuracy, with RoBERTa outperforming others at up to 96.3% accuracy on Amazon and 92% average accuracy across datasets. Compared to traditional classifiers (fastText, SVM), transformer models demonstrated superior adaptability, especially in handling informal or context-heavy language. The findings show how sentiment trends—positive reinforcement or recurring criticism—can inform strategic brand decisions. This work highlights the potential of NLP in marketing analytics and recommends future improvements in sarcasm detection and model explainability for better business alignment.},
  address = {New York, NY, USA},
  author = {You, Junqiang},
  booktitle = {Proceedings of the 2025 International Conference on Generative Artificial Intelligence for Business},
  doi = {10.1145/3766918.3766959},
  isbn = {9798400716027},
  keywords = {BERT, Brand Positioning, Consumer Feedback, RoBERTa, Sentiment Analysis, Transformer Models},
  location = {},
  numpages = {5},
  pages = {248–252},
  publisher = {Association for Computing Machinery},
  series = {GAIB '25},
  title = {Analyzing Online Consumer Sentiment with NLP and Its Implication for Brand Positioning},
  url = {https://doi.org/10.1145/3766918.3766959},
  year = {2025}
}

@article{10.1145/3767328,
  abstract = {Composed Image Retrieval (CIR) is an emerging yet challenging task that allows users to search for target images using a multimodal query, comprising a reference image and a modification text specifying the user’s desired changes to the reference image. Given its significant academic and practical value, CIR has become a rapidly growing area of interest in the computer vision and machine learning communities, particularly with the advances in deep learning. To the best of our knowledge, there is currently no comprehensive review of CIR to provide a timely overview of this field. Therefore, we synthesize insights from over 150 publications in top conferences and journals, including ACM TOIS, SIGIR, and CVPR. In particular, we systematically categorize existing supervised CIR and zero-shot CIR models using a fine-grained taxonomy. For a comprehensive review, we also briefly discuss approaches for tasks closely related to CIR, such as attribute-based CIR and dialog-based CIR. Additionally, we summarize benchmark datasets for evaluation and analyze existing supervised and zero-shot CIR methods by comparing experimental results across multiple datasets. Furthermore, we present promising future directions in this field, offering practical insights for researchers interested in further exploration.},
  address = {New York, NY, USA},
  articleno = {19},
  author = {Song, Xuemeng and Lin, Haoqiang and Wen, Haokun and Hou, Bohan and Xu, Mingzhu and Nie, Liqiang},
  doi = {10.1145/3767328},
  issn = {1046-8188},
  issue_date = {January 2026},
  journal = {ACM Trans. Inf. Syst.},
  keywords = {Composed Image Retrieval, Multimodal Retrieval, Multimodal Fusion},
  month = {November},
  number = {1},
  numpages = {54},
  publisher = {Association for Computing Machinery},
  title = {A Comprehensive Survey on Composed Image Retrieval},
  url = {https://doi.org/10.1145/3767328},
  volume = {44},
  year = {2025}
}

@article{10.1145/3768156,
  abstract = {The rapid proliferation of documents has made document intelligence increasingly critical across various industries. In recent years, Large Language Models (LLMs) have dramatically transformed the field of document intelligence, allowing for more advanced and accurate document processing solutions. Despite these advancements, most existing surveys have failed to focus on these breakthroughs, instead concentrating on traditional methods and earlier machine learning techniques. This survey seeks to fill that gap by offering an in-depth analysis of approximately 300 papers published between 2021 and mid-2025, thus providing a comprehensive overview of the impact of LLMs in document intelligence. The key topics explored include Retrieval-Augmented Generation (RAG), long-context processing, and fine-tuning LLMs for document comprehension. Furthermore, the survey highlights essential datasets, practical applications, current challenges, and future research directions, offering critical insights for both researchers and industry practitioners looking to advance the field.},
  address = {New York, NY, USA},
  articleno = {18},
  author = {Ke, Wenjun and Zheng, Yifan and Li, Yining and Xu, Hengyuan and Nie, Dong and Wang, Peng and He, Yao},
  doi = {10.1145/3768156},
  issn = {1046-8188},
  issue_date = {January 2026},
  journal = {ACM Trans. Inf. Syst.},
  keywords = {Document Intelligence, Large Language Models, RAG, Long Context},
  month = {November},
  number = {1},
  numpages = {64},
  publisher = {Association for Computing Machinery},
  title = {Large Language Models in Document Intelligence: A Comprehensive Survey, Recent Advances, Challenges, and Future Trends},
  url = {https://doi.org/10.1145/3768156},
  volume = {44},
  year = {2025}
}

@inbook{10.1145/3768292.3770377,
  abstract = {In quantitative investment, alpha factor mining plays a crucial role in predicting stock returns. Traditional approaches rely on human experts to design factors based on financial intuition. To enhance the efficiency of factor mining, recent machine learning (ML) methods have driven a shift toward automated factor mining. However, these ML-based approaches often suffer from a lack of interpretability or are restricted by predefined mathematical operators, limiting their ability to mine novel and effective factors. In this paper, we propose FactorMAD, a multi-agent debate framework based on large language models (LLMs) for interpretable alpha factor mining. Unlike existing methods, our framework employs two specialized LLM agents that iteratively refine factors through structured debate, leveraging diverse prior perspectives and critiques. To enhance factor flexibility and expressiveness, we develop a code-based factor development pipeline that allows LLMs to directly produce implementable factor code instead of being restricted to predefined operator sets. Empirically, we conduct extensive experiments on real-world stock market data, demonstrating that FactorMAD significantly outperforms existing automated factor mining methods in predictive performance and trading profitability. Our findings highlight the potential of LLM-driven multi-agent debate as a powerful paradigm for mining high-quality alpha factors in financial markets.},
  address = {New York, NY, USA},
  author = {Duan, Yitong and zhang, chuheng and Li, Jian},
  booktitle = {Proceedings of the 6th ACM International Conference on AI in Finance},
  isbn = {9798400722202},
  numpages = {9},
  pages = {605–613},
  publisher = {Association for Computing Machinery},
  title = {FactorMAD: A Multi-Agent Debate Framework Based on Large Language Models for Interpretable Stock Alpha Factor Mining},
  url = {https://doi.org/10.1145/3768292.3770377},
  year = {2025}
}

@inbook{10.1145/3768292.3770387,
  abstract = {Recent advances in Large Language Models (LLMs) have triggered a new wave of intelligent financial agents capable of complex reasoning, tool use, and autonomous decision-making. This survey presents a comprehensive review of LLM-based agents in the context of investment and trading, focusing on applications such as portfolio optimization, risk management, information retrieval, and automated strategy generation. We systematically categorize the literature by use case and architectural innovations including multi-agent collaborations, reflection mechanisms, and tool-augmented pipelines. Additionally, we review emerging evaluation frameworks and benchmark datasets tailored to finance-specific agent tasks. The survey identifies current trends, technical limitations, and open challenges related to robustness, explainability, and real-world deployment. We conclude with emerging directions for building more capable, adaptive, and trustworthy financial AI agents aligned with the demands of modern investment ecosystems.},
  address = {New York, NY, USA},
  author = {Saha, Preetha and Lyu, Jingrao and Saxena, Arnav and Zhao, Tianjiao and Mehta, Dhagash},
  booktitle = {Proceedings of the 6th ACM International Conference on AI in Finance},
  isbn = {9798400722202},
  numpages = {9},
  pages = {736–744},
  publisher = {Association for Computing Machinery},
  title = {Large Language Model Agents for Investment Management: Foundations, Benchmarks, and Research Frontiers},
  url = {https://doi.org/10.1145/3768292.3770387},
  year = {2025}
}

@inproceedings{10.1145/3768421.3768474,
  abstract = {In response to the core issues of strong subjectivity and single dimensionality in traditional evaluation methods for ideological and political education, this paper proposes an evaluation model based on multimodal data fusion and an attention mechanism, named the Multimodal Attention-based Ideological and Political Education Evaluation (MA-IEE). This model aims to achieve an objective and quantitative assessment of educational effectiveness by intelligently analyzing students' multimodal behavioral data (text, speech, vision) within an educational context, integrating deep learning with a cross-modal attention mechanism. In practical teaching applications, this model can serve as a formative assessment tool to provide teachers with immediate, fine-grained feedback on students' classroom reactions (such as emotional states) and learning engagement. This helps educators dynamically optimize teaching strategies, thereby connecting abstract educational goals with observable and analyzable student behavioral data, rather than being used merely for summative judgments. To verify the technical feasibility of the model, extensive comparative experiments and ablation studies were conducted on the publicly available multimodal emotion analysis datasets, CMU-MOSEI and IEMOCAP. The results indicate that the proposed MA-IEE model outperforms models based on single modalities and traditional fusion methods across key metrics such as accuracy, precision, recall, and F1-score, thus validating its effectiveness and superiority in fusing multimodal behavioral data for quantitative evaluation.},
  address = {New York, NY, USA},
  author = {Qi, Xiangtao and Xu, Chao},
  booktitle = {Proceedings of the 2025 International Conference on AI-Enabled Education},
  doi = {10.1145/3768421.3768474},
  isbn = {9798400719905},
  keywords = {Attention Mechanism, Deep Learning, Effect Evaluation, Ideological and Political Education, Multimodal Data Fusion},
  location = {},
  numpages = {6},
  pages = {314–319},
  publisher = {Association for Computing Machinery},
  series = {AIEE '25},
  title = {Research on Ideological and Political Education Effect Evaluation Model Based on Multimodal Data Fusion and Attention Mechanism},
  url = {https://doi.org/10.1145/3768421.3768474},
  year = {2025}
}

@inproceedings{10.1145/3768740.3768787,
  abstract = {In response to the limitations of traditional sentiment analysis models, this paper proposes an improved sentiment analysis model based on Transformer attention mechanism. This model enhances contextual semantic modeling capability by optimizing self attention and multi head attention mechanisms; Increase the number of multi head attention heads in the BERT architecture from 12 to 16 to capture multi-level emotional features; Introducing dynamic position encoding to enhance modeling of long-distance dependencies. At the same time, adjusting the learning rate to 3e-5 and combining it with data augmentation can improve the stability and generalization ability of the model. The experiment on the 33396 McDonald's review dataset showed that the accuracy, recall, and F1 score of the improved model on the test set were 78%, 75%, and 76.5%, respectively; Improved to 85%, 82%, and 83.5%. This model effectively handles multidimensional emotional expression and domain specific language. Although its interpretability needs improvement, it provides a new path for the field of sentiment analysis and has important value in scenarios such as public opinion monitoring.},
  address = {New York, NY, USA},
  author = {Ji, Qinzi},
  booktitle = {Proceedings of the 2025 International Conference on Simulation, Modeling and Big Data},
  doi = {10.1145/3768740.3768787},
  isbn = {9798400720987},
  keywords = {Attention mechanism, Emotional model, Improved accuracy, Natural language processing, Transformer},
  location = {},
  numpages = {6},
  pages = {302–307},
  publisher = {Association for Computing Machinery},
  series = {SMBD '25},
  title = {Research on sentiment analysis model improved based on Transformer attention mechanism},
  url = {https://doi.org/10.1145/3768740.3768787},
  year = {2025}
}

@inproceedings{10.1145/3769102.3774638,
  abstract = {Adverse weather, such as rain, fog, and snow, remains a major challenge for autonomous vehicles (AVs), degrading sensor reliability and compromising safety. To address this problem, we propose a novel perception pipeline augmented by a powerful vision-language model (VLM) to strengthen detection robustness and contextual understanding across diverse weather scenarios. The pipeline incorporates QwenVL to provide automatic weather labeling, semantically guided data augmentation, and adaptive sensor prioritization through weather-aware reasoning. We evaluate the approach on the BDD100K dataset using YOLOv10-M and RF-DETR, two strong detectors under adverse weather in our baseline comparisons. With VLM integration, both models achieve 8–12% gains in mean Average Precision in rainy and foggy conditions while incurring minimal additional latency. These results indicate that VLM-augmented perception can improve decision reliability and model explainability in autonomous driving. The findings underscore the value of context-aware, interpretable, and computationally efficient perception frameworks for achieving reliable all-weather autonomy.},
  address = {New York, NY, USA},
  articleno = {72},
  author = {Polin, Johora Akter and Luo, Yichen and Lu, Sidi},
  booktitle = {Proceedings of the Tenth ACM/IEEE Symposium on Edge Computing},
  doi = {10.1145/3769102.3774638},
  isbn = {9798400722387},
  keywords = {autonomous driving, vision-language model, adverse weather, perception robustness},
  location = {the Hilton Arlington National Landing, Arlington, VA, USA},
  numpages = {7},
  publisher = {Association for Computing Machinery},
  series = {SEC '25},
  title = {Context-Aware Perception: VLM-Augmented All-Weather Detection for Autonomous Driving},
  url = {https://doi.org/10.1145/3769102.3774638},
  year = {2025}
}

@inproceedings{10.1145/3769748.3773354,
  abstract = {In Japan, the “Comparable Sales Approach” is the most common method for real estate appraisal. However, this approach often fails to adequately reflect regional characteristics. This study constructs a region-specific price prediction model using LightGBM with transaction data of pre-owned condominiums in Minato Ward, Tokyo. The model extracts the importance of price-determining factors (features), which are then compared across regions. Differences in the influence of factors such as distance to the nearest station, building age, floor level, floor area, and view conditions were identified, highlighting both interregional variations and deviations from overall trends. Furthermore, by employing generative AI for analysis, this study clarifies region-specific determinants and demonstrates the potential to enhance transparency, foster trust among property owners, and improve the practical application of real estate sales appraisals. Our results show the importance of incorporating region-specific determinants, contributing to greater transparency and trust in property markets.},
  address = {New York, NY, USA},
  articleno = {15},
  author = {Sabe, Shotaro and Mitobe, Nobuyuki and Masuda, Shuntaro and Yamasaki, Toshihiko},
  booktitle = {Proceedings of the 7th ACM International Conference on Multimedia in Asia},
  doi = {10.1145/3769748.3773354},
  isbn = {9798400722479},
  keywords = {Real Estate, Prices, Machine Learning},
  location = {},
  numpages = {5},
  publisher = {Association for Computing Machinery},
  series = {MMAsia '25 Workshops},
  title = {Regional Differences in Feature Importances for Real Estate Prices},
  url = {https://doi.org/10.1145/3769748.3773354},
  year = {2025}
}

@article{10.1145/3769771,
  abstract = {Query optimization is a complex planning and decision-making problem within the exponentially growing plan space in database management systems (DBMS). Traditional optimization techniques have been extensively studied over decades, leaving limited room for further improvement along this track. Recent developments of Large Language Models (LLMs) have demonstrated their potential in solving complex planning and decision-making problems, such as arithmetic and programmatic tasks. In this paper, we try to explore the potential of LLMs in handling query optimization and propose a tentative LLM-based query optimizer dubbed LLM-QO, established on PostgreSQL's execution engine. In LLM-QO, we formulate query optimization in an autoregressive fashion which directly generates the execution plan without explicit plan enumeration. To investigate the essential input of LLM-QO, we design a customized data recipe named QInstruct to collect the training data from various optimizers and serialize the database's meta data, queries and corresponding plans into a textual format. Based on QInstruct, we implement a two-stage fine-tuning pipeline, Query Instruction Tuning (QIT) and Query Direct Preference Optimization (QDPO), to empower the capability of general-purpose LLMs in handling query optimization. In our experiments, LLM-QO can generate valid and high-quality plans and consistently outperforms both traditional and learned optimizers on three query workloads. Our findings verify that LLMs can be derived as query optimizers where generalization, efficiency and adaptivity deserve further research efforts.},
  address = {New York, NY, USA},
  articleno = {306},
  author = {Tan, Jie and Zhao, Kangfei and Li, Rui and Yu, Jeffrey Xu and Piao, Chengzhi and Cheng, Hong and Meng, Helen and Zhao, Deli and Rong, Yu},
  doi = {10.1145/3769771},
  issue_date = {December 2025},
  journal = {Proc. ACM Manag. Data},
  keywords = {learned query optimization, machine learning for systems},
  month = {December},
  number = {6},
  numpages = {28},
  publisher = {Association for Computing Machinery},
  title = {Can Large Language Models Be Query Optimizer for Relational Databases?},
  url = {https://doi.org/10.1145/3769771},
  volume = {3},
  year = {2025}
}

@article{10.1145/3770071,
  abstract = {Exploratory Data Analysis (EDA) is an essential yet tedious process for examining a new dataset. To facilitate it, Natural Language Interfaces (NLIs) can help people intuitively explore the dataset via data-oriented questions. However, existing NLIs primarily focus on providing accurate answers to questions, with few offering explanations or presentations of the data analysis pipeline used to uncover the answer. Such presentations are crucial for EDA as they enhance the interpretability and reliability of the answer, while also helping users understand the analysis process and derive insights. To fill this gap, we introduce Urania, a natural language interactive system that can visualize the data analysis pipelines used to resolve input questions. It integrates a NLI that allows users to explore data via questions, and a novel data-aware question decomposition algorithm that resolves each input question into a data analysis pipeline. This pipeline is visualized in the form of a datamation, with animated presentations of analysis operations and their corresponding data changes. Through two quantitative experiments and expert interviews, we demonstrated that our data-aware question decomposition algorithm shows competitive performance compared to existing techniques in terms of execution accuracy, and that Urania can help people explore datasets better. In the end, we discuss the observations from the studies and the potential future works.},
  address = {New York, NY, USA},
  articleno = {9},
  author = {Guo, Yi and Qi, Xiaoyu and Li, Haoyang and Zhang, Jing and Shi, Danqing and Chen, Qing and Weiskopf, Daniel and Cao, Nan},
  doi = {10.1145/3770071},
  issn = {2160-6455},
  issue_date = {March 2026},
  journal = {ACM Trans. Interact. Intell. Syst.},
  keywords = {natural language interface, visualization},
  month = {January},
  number = {1},
  numpages = {26},
  publisher = {Association for Computing Machinery},
  title = {Urania: Visualizing Data Analysis Pipelines for Natural Language-Based Data Exploration},
  url = {https://doi.org/10.1145/3770071},
  volume = {16},
  year = {2026}
}

@inproceedings{10.1145/3770177.3770220,
  abstract = {Within the complex manifold of financial linguistics, robust sentiment analysis demands domain-specific language modeling and transparent reasoning mechanisms—yet con-ventional pre-trained architectures frequently demonstrate inadequate performance when confronted with the subtle complexities of market discourse. We present herein a pa-rameter-efficient framework constructed upon a compact nanoLLaVA architecture to address fine-grained financial sentiment classification with mathematical precision. Our methodology incorporates chain-of-thought prompting to extract sequential logical rea-soning and employs direct preference optimization to harmonize model outputs with ex-pertly curated exemplars. Experimental evidence from the StockEmotions corpus demonstrates that this convergence of CoT prompting and DPO substantially enhances both accuracy metrics and logical coherence. Our approach yields significant perfor-mance improvements over existing models. These empirical findings confirm that do-main-specialized alignment combined with explicit reasoning pathways constitutes a fundamental requirement for reliable and interpretable sentiment analysis within algo-rithmic trading systems.},
  address = {New York, NY, USA},
  author = {Fang, Zanyu},
  booktitle = {Proceedings of the 2025 International Conference on Economic Management and Big Data Application},
  doi = {10.1145/3770177.3770220},
  isbn = {9798400720109},
  keywords = {Chain of thoughts, Financial Sentiment Analysis, direct preference optimization},
  location = {},
  numpages = {5},
  pages = {275–279},
  publisher = {Association for Computing Machinery},
  series = {ICEMBDA '25},
  title = {Lightweight VLM for Financial Sentiment Analysis and Investment Decision Support},
  url = {https://doi.org/10.1145/3770177.3770220},
  year = {2025}
}

@inproceedings{10.1145/3770177.3770250,
  abstract = {Share pledging serves as a crucial financing instrument in China's multi-tiered capital market. However, traditional corporate governance mechanisms often fail to effectively restrain the self-serving behavior of controlling shareholders, resulting in market manipulation and infringement upon investor interests that significantly harm investor welfare. With the rapid development of artificial intelligence (AI), exploring the impact of AI applications in share pledging scenarios provides a novel approach to curb controlling shareholders' opportunistic behavior, enhance investor protection, and advance the modernization of AI-driven governance. This study aims to explore the mechanism through which AI applications influence the controlling shareholders’ share pledging behavior and the subsequent effects on investor interest protection. Moreover, considering the current limitations of regulatory large models in addressing share pledging behaviors and investor protection, this study proposes a regulatory framework based on FinBERT, a financial-domain language model specialized in semantic risk extraction from financial texts. Theoretically, this study contributes to the interdisciplinary integration of AI and corporate governance and deepens the understanding of investor protection mechanisms in share pledging scenarios. Practically, it provides actionable insights to policymakers and market participants, supporting the application of AI technologies to strengthen investor protection frameworks.},
  address = {New York, NY, USA},
  author = {Zhuang, Junming and Fu, Shenze},
  booktitle = {Proceedings of the 2025 International Conference on Economic Management and Big Data Application},
  doi = {10.1145/3770177.3770250},
  isbn = {9798400720109},
  keywords = {Artificial intelligence application, Controlling shareholders’ share pledging, Investor interest protection},
  location = {},
  numpages = {7},
  pages = {450–456},
  publisher = {Association for Computing Machinery},
  series = {ICEMBDA '25},
  title = {The Influence Mechanism and Empowerment Framework of Artificial Intelligence in Protecting Investor Interests within Share Pledging Scenarios},
  url = {https://doi.org/10.1145/3770177.3770250},
  year = {2025}
}

@article{10.1145/3770644,
  abstract = {With advancements in mobile sensing technologies, there is a growing need for scalable and interpretable stress monitoring solutions that remain robust over time. Existing smartphone passive sensing approaches rely on statistical app usage features or multi-modal sensor data, making them susceptible to distribution shift and feature evolution (e.g., schema drift), and adding model complexity. To address these challenges, we propose the Smartphone Human Interaction-based Routine Behavior Task Mining, Modeling, and Feature Extraction (SHIRBT-MMF) framework, which models stress-related behaviors by mining finegrained interaction routine tasks rather than aggregated app usage patterns. SHIRBT-MMF leverages multi-level sequential pattern mining and large language model-based automated task modeling to extract interpretable and stable features from within-app UI state transitions. Unlike traditional methods that require hundreds of apps, SHIRBT focuses on a small, consistent set of routine-based tasks, mitigating covariate shift and feature evolution while improving model robustness. We validated SHIRBT-MMF through one- and four-month in-the-wild datasets with 26 participants, demonstrating that the SHIRBT-based personalized model achieves an average accuracy of 75%, outperforming baseline models by 5% while using only 3-6% of app types. Additionally, SHIRBT features remain stable over time, reducing covariate shift and ensuring reliable performance. With its expandability to other mental health, interpretability, and privacy-conscious design, the SHIRBT-MMF framework lays the foundation for personalized digital mental health monitoring.},
  address = {New York, NY, USA},
  articleno = {187},
  author = {Lee, Hansoo and Park, Taehyeon and Koh, Youngji and Lee, Jae-Gil and Lee, Uichin},
  doi = {10.1145/3770644},
  issue_date = {December 2025},
  journal = {Proc. ACM Interact. Mob. Wearable Ubiquitous Technol.},
  keywords = {Smartphone sensing, Routine behavior mining, Sequential pattern mining, Explainable digital phenotyping, LLM-based task annotation, Distribution shift robustness, Feature evolution resilience, Stress monitoring},
  month = {December},
  number = {4},
  numpages = {45},
  publisher = {Association for Computing Machinery},
  title = {Leveraging Smartphone Human Interaction Routine Behavior Task Mining and Modeling for Daily Stress Monitoring},
  url = {https://doi.org/10.1145/3770644},
  volume = {9},
  year = {2025}
}

@inproceedings{10.1145/3771678.3771686,
  abstract = {This article explores Large Language Models (LLMs) as a Service (LLMaaS), a paradigm rapidly transforming the landscape of artificial intelligence. LLMs, a class of foundation models trained on extensive data, offer immense opportunities across diverse applications by generating human-like text and performing complex language tasks. LLMaaS democratizes access to these powerful models, enabling developers and businesses to integrate advanced AI capabilities without managing underlying infrastructure. A core challenge for LLMs, particularly for LLMaaS offerings, is hallucination, where models generate factually incorrect or nonsensical information. Addressing this, initiatives like the Model Context Protocol (MCP) are crucial for enhancing the structure and reliability of LLMaaS. MCP allows LLMs to fetch and cite information from external, real-time sources, directly in their responses. This mechanism significantly enhances truthfulness, providing transparency through verifiable citations and mitigating factual errors. Companies like Anthropic are actively developing MCP, with support from entities such as Microsoft's Windows AI Foundry. The architecture of LLMaaS solutions often leverages sophisticated components, including attention mechanisms fundamental to the underlying LLM architectures. To analyze these aspects, this study combines a structured literature review with the examination of non-commercial academic case studies that integrate LLMaaS into legal assistance and document management systems. The profound impact of LLMaaS lies in its potential to accelerate AI adoption and innovation across industries. However, its successful, responsible deployment hinges on robust solutions for ensuring data provenance, factual accuracy, and explainability. This article is particularly relevant for researchers, developers, educators, policy makers, and emerging businesses, as it delves into the intricate structure of LLMaaS offerings, their broad societal and technological impact, and the critical challenges that must be overcome to realize their full potential, particularly in ensuring reliability and mitigating risks associated with untruthful outputs.},
  address = {New York, NY, USA},
  author = {Gonzalez Torres, Daniel Leonardo and Santa Quintero, Ricardo Andres},
  booktitle = {Proceedings of the 2025 8th International Conference on Systems Engineering - Cybersecurity &amp; AI: Building a Reliable Digital Future},
  doi = {10.1145/3771678.3771686},
  isbn = {9798400718809},
  location = {},
  numpages = {10},
  pages = {53–62},
  publisher = {Association for Computing Machinery},
  series = {CIIS '25},
  title = {From Model to Service: Analyzing LLM-as-a-Service as a Driver of Digital Transformation},
  url = {https://doi.org/10.1145/3771678.3771686},
  year = {2025}
}

@article{10.1145/3771772,
  abstract = {API recommendation is a crucial task in code intelligence, aiming to suggest suitable APIs for programming queries. Recent efforts have integrated Large Language Models (LLMs) into this task. However, these methods overlook the compatibility between recommended APIs and fail to fully utilize the factual knowledge of APIs. Moreover, these prompting-only methods are limited by the insufficient domain-specific knowledge of LLMs. In this article, we propose a novel fine-tuning method, KDRAR, designed to leverage knowledge-driven reasoning with LLMs for compatible and interpretable API recommendation. To fully utilize the factual knowledge, we introduce a dual matching strategy that leverages both function descriptions and keyword matching to retrieve candidate APIs. To handle compatibility, we translate compatibility information into descriptive knowledge, which is integrated into the recommendation process. Furthermore, we adopt a distilled fine-tuning strategy: a student LLM is trained via distillation from a teacher LLM to perform step-by-step reasoning for enhanced recommendation and explanation. By considering both function matching and compatibility information, the knowledge-driven reasoning not only improves API recommendation accuracy but also provides reasonable explanations for the recommendations. Experimental results show that our method significantly outperforms baseline methods on API recommendation tasks across multiple API domains.},
  address = {New York, NY, USA},
  articleno = {27},
  author = {Qi, Lianyong and Xie, Jianye and Hu, Chunhua and Xu, Xiaolong and Xiang, Haolong and Dai, Haipeng and Gu, Rong and Zhang, Xuyun and Dou, Wanchun},
  doi = {10.1145/3771772},
  issn = {1046-8188},
  issue_date = {January 2026},
  journal = {ACM Trans. Inf. Syst.},
  keywords = {API Recommendation, Recommender Systems, Large Language Models},
  month = {December},
  number = {1},
  numpages = {30},
  publisher = {Association for Computing Machinery},
  title = {Knowledge-Driven Reasoning for Compatible and Interpretable API Recommendation via Teacher LLM&nbsp;Distillation},
  url = {https://doi.org/10.1145/3771772},
  volume = {44},
  year = {2025}
}

@inproceedings{10.1145/3772356.3772385,
  abstract = {Cloud systems constantly experience changes. Unfortunately, these changes often introduce regression failures, breaking the same features or functionalities repeatedly. Such failures disrupt cloud availability and waste developers' efforts in re-investigating similar incidents. In this position paper, we argue that regression failures can be effectively prevented by enforcing low-level semantics, a new class of intermediate rules empirically inferred from past incidents, yet capable of offering partial correctness guarantees. Our experience shows that such rules are valuable to strengthen system correctness guarantees and expose new bugs.},
  address = {New York, NY, USA},
  author = {Parikesit, Dimas and Lou, Chang},
  booktitle = {Proceedings of the 24th ACM Workshop on Hot Topics in Networks},
  doi = {10.1145/3772356.3772385},
  isbn = {9798400722806},
  keywords = {cloud systems, regression failures, large language models, symbolic execution},
  location = {UMD Campus, College Park, MD, USA},
  numpages = {9},
  pages = {335–343},
  publisher = {Association for Computing Machinery},
  series = {HotNets '25},
  title = {Once Bitten, Still Shy: Can We Prevent Cloud Systems from Repeating Their Mistakes?},
  url = {https://doi.org/10.1145/3772356.3772385},
  year = {2025}
}

@inproceedings{10.1145/3772356.3772413,
  abstract = {Policy design for various systems controllers has conventionally been a manual process, with domain experts carefully tailoring heuristics for the specific instance in which the policy will be deployed. In this paper, we re-imagine policy design via a novel automated search technique fueled by recent advances in generative models, specifically Large Language Model (LLM)-driven code generation. We outline the design and implementation of PolicySmith, a framework that applies LLMs to synthesize instance-optimal heuristics. We apply PolicySmith to two long-standing systems policies - web caching and congestion control, highlighting the opportunities unraveled by this LLM-driven heuristic search. For caching, PolicySmith discovers heuristics that outperform established baselines on standard open-source traces. For congestion control, we show that PolicySmith can generate safe policies that integrate directly into the Linux kernel.},
  address = {New York, NY, USA},
  author = {Dwivedula, Rohit and Saxena, Divyanshu and Akella, Aditya and Chaudhuri, Swarat and Kim, Daehyeok},
  booktitle = {Proceedings of the 24th ACM Workshop on Hot Topics in Networks},
  doi = {10.1145/3772356.3772413},
  isbn = {9798400722806},
  keywords = {ML for systems, program synthesis, LLM-driven code generation, caching, congestion control},
  location = {UMD Campus, College Park, MD, USA},
  numpages = {10},
  pages = {51–60},
  publisher = {Association for Computing Machinery},
  series = {HotNets '25},
  title = {Man-Made Heuristics Are Dead. Long Live Code Generators!},
  url = {https://doi.org/10.1145/3772356.3772413},
  year = {2025}
}

@inproceedings{10.1145/3772886.3776629,
  abstract = {As underground hydrogen storage technology advances, accurate geological assessment of salt caverns and dynamic safety deci-sion-making have become crucial for ensuring storage system security and efficiency. Current approaches primarily depend on manual rules and static analysis, which cannot effectively handle heterogeneous geological data or evolving operational complexi-ties. To overcome these limitations, this research introduces an intelligent computational framework, GeoRisk-LLM, powered by a do-main-specific large language model. The framework incorporates standardized semantic mapping of multi-source geological data, builds a Vectorized Geological Knowledge Base (VGKB), employs a Retrieval-Augmented Generation (RAG) mechanism, and utiliz-es locally deployed vertical LLM inference. This enables high-accuracy environmental suitability prediction, real-time identifica-tion of risks like microbial corrosion and pressure fluctuations, and automated generation of structured adaptive safety strategies. Experimental results show that our method exceeds conventional machine learning models by 8.2% in suitability classification accuracy and improves decision robustness by over 15% under extreme conditions. In multi-task evaluations including risk ex-planation, strategy generation, and scenario adaptation, GeoRisk-LLM outperforms mainstream models such as GPT-4o and DeepSeek-R1, achieving F1-scores of 0.91, 0.93, and 0.88 respectively. The RAG integration further enhances performance, boosting the F1-score by 0.052 compared to LLM-only approaches.},
  address = {New York, NY, USA},
  articleno = {11},
  author = {Liu, Xing and Wang, Fuzhi and Ding, Kewei and Xiong, Ziyan and Zhang, Wei},
  booktitle = {Proceedings of the 9th International Conference on Computer Science and Application Engineering},
  doi = {10.1145/3772886.3776629},
  isbn = {9798400713262},
  keywords = {Multimodal modeling, Underground hydrogen storage, Geological assessment, Retrieval-augmented generation},
  location = {},
  numpages = {6},
  publisher = {Association for Computing Machinery},
  series = {CSAE '25},
  title = {Application of Knowledge-Driven Multimodal Modeling in Geological Assessment and Risk Identification of Underground Hydrogen Storage},
  url = {https://doi.org/10.1145/3772886.3776629},
  year = {2025}
}

@article{10.1145/3773084,
  abstract = {Machine Learning (ML) workflows—spanning data preprocessing and feature engineering, model selection and hyperparameter optimization, and workflow evaluation—are increasingly embedded in complex software systems. Building these workflows manually demands substantial ML expertise, domain knowledge, and engineering effort. Automated ML (AutoML) frameworks address parts of this challenge but often suffer from constrained search spaces, limited adaptability, and low interpretability. Recent advances in Large Language Models (LLMs) have opened new opportunities to automate and enhance ML workflows by leveraging their capabilities in language understanding, reasoning, interaction, and code generation, posing new practical and theoretical challenges for software engineering (SE). This survey provides the first SE-oriented, stage-wise review of LLM-based ML workflow automation. We introduce a taxonomy covering all three workflow stages, systematically compare and analyze state-of-the-art methods, and synthesize both stage-specific and cross-stage trends. Our analysis yields SE-oriented implications, including the need for robust verification, quality management, context-aware deployment, and risk mitigation, alongside ensuring key quality attributes such as usability, modularity, traceability, and performance. The findings also call for adapting development models, rethinking lifecycle boundaries, and formalizing uncertainty handling to address the probabilistic and collaborative nature of LLM-assisted workflow generation. We further identify major open challenges and outline future research directions to guide the reliable and effective adoption of LLMs in ML workflow development. Our artifacts are publicly available at .},
  address = {New York, NY, USA},
  author = {Gu, Yang and You, Hengyu and Cao, Jian and Yu, Muran and Fan, Haoran and Qian, Shiyou},
  doi = {10.1145/3773084},
  issn = {1049-331X},
  journal = {ACM Trans. Softw. Eng. Methodol.},
  keywords = {Machine Learning Workflows, Large Language Models, Software Engineering, AutoML, Survey},
  month = {October},
  note = {Just Accepted},
  publisher = {Association for Computing Machinery},
  title = {Large Language Models for Constructing and Optimizing Machine Learning Workflows: A Survey},
  url = {https://doi.org/10.1145/3773084},
  year = {2025}
}

@inproceedings{10.1145/3773365.3773406,
  abstract = {Traditional financial early warning models primarily rely on structured financial data, making it challenging to capture dynamic corporate risks and implicit signals within unstructured information. To address this, this study proposes a dynamic financial crisis prediction model based on multimodal graph neural networks (Multimodal-GNN), integrating three types of heterogeneous data: financial statements, management text sentiment, and corporate association networks. Empirical results demonstrate that this model significantly outperforms traditional benchmark models in both prediction accuracy (AUC improved to 0.836) and early warning time (advance to 6 months), with textual sentiment and network information providing substantial incremental predictive value. This research offers a novel theoretical perspective and robust analytical tools for corporate risk monitoring.},
  address = {New York, NY, USA},
  author = {Sun, Yanjun and Liu, Qi and Su, Hong},
  booktitle = {Proceedings of the 2025 8th International Conference on Computer Information Science and Artificial Intelligence},
  doi = {10.1145/3773365.3773406},
  isbn = {9798400718748},
  keywords = {Financial crisis prediction, explainable artificial intelligence, graph neural networks, multimodal learning, risk contagion, text analysis},
  location = {},
  numpages = {8},
  pages = {253–260},
  publisher = {Association for Computing Machinery},
  series = {CISAI '25},
  title = {Dynamic Financial Distress Prediction: A Multimodal Graph Neural Network Approach},
  url = {https://doi.org/10.1145/3773365.3773406},
  year = {2025}
}

@inproceedings{10.1145/3773365.3773410,
  abstract = {Static analysis is effective for discovering software vulnerabilities but notoriously suffers from incomplete source–sink specifications and excessive false positives (FPs). We present AdaTaint, an LLM-driven taint analysis framework that adaptively infers source/sink specifications and filters spurious alerts through neuro-symbolic reasoning. Unlike LLM-only detectors, AdaTaint grounds model suggestions in program facts and constraint validation, ensuring both adaptability and determinism.We evaluate AdaTaint on Juliet 1.3, SV-COMP-style C benchmarks, and three large real-world projects. Results show that AdaTaint reduces false positives by 43.7% on average and improves recall by 11.2% compared to state-of-the-art baselines (CodeQL, Joern, and LLM-only pipelines), while maintaining competitive runtime overhead. These findings demonstrate that combining LLM inference with symbolic validation offers a practical path toward more accurate and reliable static vulnerability analysis.},
  address = {New York, NY, USA},
  author = {Lin, Shiyin},
  booktitle = {Proceedings of the 2025 8th International Conference on Computer Information Science and Artificial Intelligence},
  doi = {10.1145/3773365.3773410},
  isbn = {9798400718748},
  location = {},
  numpages = {5},
  pages = {281–285},
  publisher = {Association for Computing Machinery},
  series = {CISAI '25},
  title = {LLM-Driven Adaptive Source–CSink Identification and False Positive Mitigation for Static Analysis},
  url = {https://doi.org/10.1145/3773365.3773410},
  year = {2025}
}

@inproceedings{10.1145/3773365.3773415,
  abstract = {As a cutting-edge achievement in the field of deep learning, large language models (LLMs) possess exceptional natural language processing capabilities such as text generation, knowledge reasoning, and semantic understanding. Focusing on the military field, this paper initially constructs a specialized fine-tuning dataset and a knowledge question-answering system for military based on Large Language Models (LLMs) by analyzing the principles and training processes of LLMs. Experimental results show that the system can efficiently generate accurate knowledge in the equipment domain, achieving scores of 26.56, 18.88, 35.24, and 28.98 in the four evaluation metrics of ROUGE-1, ROUGE-2, ROUGE-L, and BLEU-2, respectively. Additionally, the paper conducts a forward-looking analysis on the future development direction of LLMs in the military field, providing theoretical support and practical references for the advancement of military intelligentization.},
  address = {New York, NY, USA},
  author = {Zhao, Zhongshi and Wu, Zhenglong and Meng, Qi},
  booktitle = {Proceedings of the 2025 8th International Conference on Computer Information Science and Artificial Intelligence},
  doi = {10.1145/3773365.3773415},
  isbn = {9798400718748},
  keywords = {Fine-tuning, large language models, military question-answering system, pre-training},
  location = {},
  numpages = {9},
  pages = {311–319},
  publisher = {Association for Computing Machinery},
  series = {CISAI '25},
  title = {Large Language Models and Their Applications in the Military Field},
  url = {https://doi.org/10.1145/3773365.3773415},
  year = {2025}
}

@inproceedings{10.1145/3773365.3773416,
  abstract = {Power grid enterprises increasingly face the challenge of interpreting complex financial and taxation policies while providing practical operational guidance across diverse jurisdictions and tax categories. Existing methods suffer from imprecise keyword-based retrieval, and they have limited capability in generating structured guidance. To address these issues, we propose a Fiscal and Tax QA via Clause-Level Knowledge Graphs and Retrieval-Grounded Large Language Models. Specifically, we propose a clause-level knowledge graph retrieval method that combines semantic similarity with graph structure by encoding queries and clauses through transformer-based embeddings, retrieving top- ({rm{K}} )  candidate clauses via approximate nearest neighbor search, and re-ranking them with a legal consistency module that enforces domain-specific constraints. To generate actionable financial guidance grounded in verified statutes, we propose a retrieval-based LLM framework that produces structured and executable answers by constructing prompts from the re-ranked clauses together with step-by-step instructions, and by applying LoRA-based fine-tuning with light citation constraints to ensure both accuracy and interpretability. Finally, the experimental results demonstrate that our model achieves consistent improvements over baseline methods on two datasets: WebQSP (Hit1 improved by 11.2%, Hit3 by 6.7%, and Hit10 by 3.6%) and GridTax-QA (Hit1 improved by 5.7%, Hit3 by 4.4%, and Hit10 by 2.6%). Our framework advances retrieval and answer generation, providing a foundation for interpretable financial-taxation decision support.},
  address = {New York, NY, USA},
  author = {Chen, Hao and Bu, Xianglei and Tian, Shupeng},
  booktitle = {Proceedings of the 2025 8th International Conference on Computer Information Science and Artificial Intelligence},
  doi = {10.1145/3773365.3773416},
  isbn = {9798400718748},
  keywords = {Fine tuning, Fiscal and Tax, Knowledge Graph, LLMs, QA},
  location = {},
  numpages = {5},
  pages = {320–324},
  publisher = {Association for Computing Machinery},
  series = {CISAI '25},
  title = {Fiscal and Tax QA via Clause-Level Knowledge Graphs and Retrieval-augmented Large Language Models},
  url = {https://doi.org/10.1145/3773365.3773416},
  year = {2025}
}

@inproceedings{10.1145/3773365.3773623,
  abstract = {This paper explores the application of data intelligence agents in security protection. It analyzes their practical impact across critical sectors including education, finance, industrial systems, and healthcare. Significant outcomes include improved detection accuracy, sub-second response times, and reduced compliance costs. A tri-layered architecture (encryption/fortification/isolation) and cognitive closed-loop framework are introduced. This framework spans knowledge graphs, deep detection, and reinforcement optimization. Together, they transform traditional passive defense models. This research provides methodological foundations for establishing new paradigms of cognitive collaborative defense in the security industry.},
  address = {New York, NY, USA},
  author = {Chen, Huiyan and Wang, Yiqi and Chen, Qiang},
  booktitle = {Proceedings of the 2025 8th International Conference on Computer Information Science and Artificial Intelligence},
  doi = {10.1145/3773365.3773623},
  isbn = {9798400718748},
  keywords = {Cognitive Decision-Making, Data Security, Intelligent Agent, Layered Protection},
  location = {},
  numpages = {8},
  pages = {1644–1651},
  publisher = {Association for Computing Machinery},
  series = {CISAI '25},
  title = {Research on the Application of Data Intelligence-Based Intelligent Agents in Data Security Protection},
  url = {https://doi.org/10.1145/3773365.3773623},
  year = {2025}
}

@article{10.1145/3774655,
  abstract = {In the era of Industry 5.0, Unmanned Aerial Vehicles (UAVs) equipped with multiple sensors play a vital role in industrial tasks such as patrol and surveillance, offering distinct advantages of high mobility, accurate perception, and autonomous operation. However, traditional path planning methods for UAVs struggle with challenges related to interpretability and adaptation to dynamic industrial environments. To address these challenges, this paper proposes a novel LLM-based approach to UAV swarm path planning in autonomous and adaptive industrial systems. The proposed method aims to minimize the time and computational consumption of path planning while improving the task completion rate of UAVs. Specifically, we first propose the multi-step deep thinking movement decision samples generation algorithm (MSDTMD-SG) to generate deep thinking training samples for LLMs at different ends and fine-tune them. Second, we design a scene memory and replay learning mechanism, enabling damaged UAVs to store perceived information and generate training samples via MSDTMD-SG for continuous LLM learning and optimization. Finally, extensive experiments demonstrate that the proposed method exhibits strong adaptability to dynamic environments, achieves the highest task completion rate among all methods, and maintains competitive system consumption.},
  address = {New York, NY, USA},
  author = {Xiao, Wenjing and Shi, Chenglong and Chen, Miaojiang and Vasilakos, Athanasios V. and Chen, Min and Farouk, Ahmed},
  doi = {10.1145/3774655},
  issn = {1556-4665},
  journal = {ACM Trans. Auton. Adapt. Syst.},
  keywords = {Large language model, UAV swarm path planing, cloud-edge collaboration, industry system},
  month = {November},
  note = {Just Accepted},
  publisher = {Association for Computing Machinery},
  title = {LLM-based UAV Path Planning for Autonomous and Adaptive Industry Systems},
  url = {https://doi.org/10.1145/3774655},
  year = {2025}
}

@article{10.1145/3774942,
  abstract = {Recent studies have shown that large language models (LLMs) can assess relevance and support information retrieval (IR) tasks such as document ranking and relevance judgment generation. However, the internal mechanisms by which off-the-shelf LLMs understand and operationalize relevance remain largely unexplored. In this article, we systematically investigate how different LLM modules contribute to relevance judgment through the lens of mechanistic interpretability. Using activation patching techniques, we analyze the roles of various model components and identify a multi-stage, progressive process in generating either pointwise or pairwise relevance judgment. Specifically, LLMs first extract query and document information in the early layers, then process relevance information according to instructions in the middle layers, and finally utilize specific attention heads in the later layers to generate relevance judgments in the required format. Our findings provide insights into the mechanisms underlying relevance assessment in LLMs, offering valuable implications for future research on leveraging LLMs for IR tasks.},
  address = {New York, NY, USA},
  articleno = {34},
  author = {Liu, Qi and Duan, Haozhe and Mao, Jiaxin and Wen, Ji-Rong},
  doi = {10.1145/3774942},
  issn = {1046-8188},
  issue_date = {February 2026},
  journal = {ACM Trans. Inf. Syst.},
  keywords = {Relevance Assessment, Large Language Models, Interpretability},
  month = {December},
  number = {2},
  numpages = {27},
  publisher = {Association for Computing Machinery},
  title = {How Do Large Language Models Understand Relevance? A Mechanistic Interpretability Perspective},
  url = {https://doi.org/10.1145/3774942},
  volume = {44},
  year = {2025}
}

@inproceedings{10.1145/3775050.3775055,
  abstract = {Climate change is a globally debated topic that often polarizes public opinion. This study presents a stance and sentiment classification framework for climate change discussions on Twitter, leveraging fine-tuned BERT models. By preprocessing over 5,000 climate-related tweets, the proposed system achieves promising results in classifying both sentiment (positive, negative, neutral) and stance (support, deny, neutral). The experimental results demonstrate the effectiveness of deep learning in extracting nuanced emotional and attitudinal signals from social media texts. This framework contributes to scalable social opinion mining on large unstructured datasets, supporting future research on environmental discourse analysis. While the proposed framework achieves an improvement of approximately 9–40% over traditional baselines, this performance should be contextualized against recent transformer-based climate discourse benchmarks, where larger pre-trained models or domain-specific variants often report stronger gains. Our contribution lies in demonstrating that even a compact model like BERT-base-uncased, when paired with domain-adapted preprocessing, can achieve competitive performance on noisy climate-related text.},
  address = {New York, NY, USA},
  author = {Zhang, Xiyan},
  booktitle = {Proceedings of the 2025 7th International Conference on Big Data Engineering},
  doi = {10.1145/3775050.3775055},
  isbn = {9798400719363},
  keywords = {information retrieval, machine learning, neural networks, sentiment analysis},
  location = {},
  numpages = {6},
  pages = {31–36},
  publisher = {Association for Computing Machinery},
  series = {BDE '25},
  title = {Sentiment and Stance Classification on Climate Change Tweets Using Fine-Tuned BERT Models: A domain-adaptive NLP framework for analyzing public discourse in social media},
  url = {https://doi.org/10.1145/3775050.3775055},
  year = {2025}
}

@inproceedings{10.1145/3775073.3775105,
  abstract = {The deep integration of artificial intelligence and education serves as the core driver for the intelligent transformation of education. Knowledge graphs and large language models (LLMs) each possess distinct characteristics in data processing and knowledge application. The fusion of these two technologies can complement each other, reducing domain modeling costs while enhancing model interpretability. The content of Microcomputer Principles and Interface Technology is complex, with knowledge points scattered, making it difficult for students to grasp a clear and accurate knowledge logical structure through traditional teaching methods. To address this issue, this paper proposes LLM-driven course graph construction and its application in different teaching scenarios. First, a course graph framework is defined across three dimensions—knowledge, problems, and competencies—to address the pedagogical objectives of “what to learn,” “how to solve problems,” and “what to achieve.” Subsequently, a technical implementation roadmap for automatically constructing course knowledge graphs using LLM-based semantic understanding is presented, covering ontology design, triplet extraction, prompt engineering, and entity alignment strategies. Finally, we explore the application of course knowledge graphs and LLMs in diverse teaching scenarios from both instructor and student perspectives, providing insights for the intelligent transformation of other higher education courses.},
  address = {New York, NY, USA},
  author = {Xu, Hongxia and Cheng, Xuerui and Zuo, Guoyu},
  booktitle = {Proceedings of the 2025 2nd International Symposium on Artificial Intelligence for Education},
  doi = {10.1145/3775073.3775105},
  isbn = {9798400715792},
  keywords = {intelligent transformation of education, knowledge graph, large language model, microcomputer principles and interface technology},
  location = {},
  numpages = {6},
  pages = {188–193},
  publisher = {Association for Computing Machinery},
  series = {ISAIE '25},
  title = {Construction and Application of Knowledge Graphs for Microcomputer Principles and Interface Technology Driven by Large Language Model},
  url = {https://doi.org/10.1145/3775073.3775105},
  year = {2025}
}

@inproceedings{10.1145/3775073.3775146,
  abstract = {Technology transfer plays a pivotal role in translating academic research into practical applications, particularly in applied universities. This paper presents a comprehensive computational framework that leverages big data analytics and artificial intelligence to address longstanding challenges in technology commercialization. By integrating temporal convolutional networks with graph neural networks, we develop a sophisticated technology assessment model that achieves 94.2% prediction accuracy. The framework incorporates BERT-based semantic analysis for precise technology-industry matching and implements blockchain smart contracts for secure intellectual property management. Experimental results demonstrate a 42% improvement in technology commercialization rates and a 58% reduction in processing time. This research contributes both theoretical foundations and practical solutions for enhancing technology transfer efficiency in academic institutions.},
  address = {New York, NY, USA},
  author = {Li, Ying and Ding, Songtao},
  booktitle = {Proceedings of the 2025 2nd International Symposium on Artificial Intelligence for Education},
  doi = {10.1145/3775073.3775146},
  isbn = {9798400715792},
  keywords = {Artificial Intelligence, Big Data Analytics, Blockchain, Deep Learning, Intellectual Property Management, Technology Transfer Optimization},
  location = {},
  numpages = {5},
  pages = {460–464},
  publisher = {Association for Computing Machinery},
  series = {ISAIE '25},
  title = {A Computational Framework for Optimizing Technology Transfer Systems in Applied Universities Using Big Data and Artificial Intelligence},
  url = {https://doi.org/10.1145/3775073.3775146},
  year = {2025}
}

@inproceedings{10.1145/3776759.3776812,
  abstract = {This study deeply explores the impact of recommendation algorithms on user engagement and stickiness in live streaming platforms. Through technical analysis of algorithmic mechanisms across multiple mainstream live streaming platforms, combined with statistical modeling of large-scale user behavior data, this paper reveals the significant effects of deep learning-based recommendation algorithms in improving user activity, increasing viewing time, and promoting interaction. The research employs various algorithmic models including collaborative filtering, content-based recommendation, and deep neural networks. Through A/B testing and offline evaluation, it quantifies the impact of different algorithms on user engagement. Additionally, this paper discusses optimization strategies for algorithms in processing virtual host content and addressing real-time challenges, and proposes improvement directions based on reinforcement learning and multimodal fusion.},
  address = {New York, NY, USA},
  author = {Mei, Zizi},
  booktitle = {Proceedings of the 2025 International Symposium on Artificial Intelligence and Computational Social Sciences},
  doi = {10.1145/3776759.3776812},
  isbn = {9798400721007},
  keywords = {A/B testing, Collaborative filtering, Deep learning, Live streaming platform, Multimodal fusion, Recommendation algorithm, Reinforcement learning, User engagement, User stickiness},
  location = {},
  numpages = {5},
  pages = {346–350},
  publisher = {Association for Computing Machinery},
  series = {AICSS '25},
  title = {Research on the Impact of Live Streaming Platform Recommendation Algorithms on User Engagement and Stickiness},
  url = {https://doi.org/10.1145/3776759.3776812},
  year = {2025}
}

@inproceedings{10.1145/3776759.3776823,
  abstract = {Personnel information retrieval in the Smart Organizational Management Platform (SOMP) faces challenges including insufficient semantic understanding, lack of domain-specific knowledge, and data compliance constraints. To address this, we introduce HR-LLM, a lightweight LLM fine-tuning framework for government HR. Our approach integrates an organizational behavior knowledge graph and a user behavior-aware query mechanism to bridge semantic gaps and meet compliance requirements. It encodes rules from documents like the Regulations on the Assessment of Party and Government Leading Cadres into a dual-task loss function and employs a behavior-aware algorithm for personalized searches. Tests on a desensitized SOMP dataset show HR-LLM achieves 92.1% accuracy in parsing complex queries and an 82.3% Recall@5 for professional terms, all while responding in under 500ms on an 8GB GPU. A case study confirms its effectiveness in handling intricate requests, such as finding "department-level cadres with provincial commendations and extensive grassroots experience." This work bridges a gap in semantic understanding of government HR using LLMs and offers a scalable and deployable solution for intelligent talent management systems in state-owned enterprises and government agencies, facilitating technological advancement in smart organizational platforms.},
  address = {New York, NY, USA},
  author = {Chen, Liang and Wang, Jun and Ding, Hong-Yu and Gao, Yu-Qing and Wu, Xian-Min and Zhang, Yang and Zhu, Xuan},
  booktitle = {Proceedings of the 2025 International Symposium on Artificial Intelligence and Computational Social Sciences},
  doi = {10.1145/3776759.3776823},
  isbn = {9798400721007},
  keywords = {Domain-specific Fine-tuning, Government AI, Large Language Models, Personnel Information Retrieval, Retrieval-Augmented Generation},
  location = {},
  numpages = {8},
  pages = {418–425},
  publisher = {Association for Computing Machinery},
  series = {AICSS '25},
  title = {HR-LLM: Towards Semantically Enhanced Personnel Retrieval in SOEs with Knowledge Graph and LLM Fine-Tuning},
  url = {https://doi.org/10.1145/3776759.3776823},
  year = {2025}
}

@inproceedings{10.1145/3776865.3776921,
  abstract = {Efficient and accurate matching between material specifications and price information is a key challenge in construction cost estimation. Manual comparison is inefficient and error-prone, while existing automated retrieval methods often rely on single-channel modeling or global fusion, failing to balance semantic understanding with precise field-level matching. This paper proposes an intelligent retrieval framework for construction material price information based on dual-channel hybrid semantic modeling. First, a large language model–driven query semantic enhancement mechanism performs semantic alignment and field explicitness, mitigating noise, abbreviations, and ambiguities in raw queries. Second, a field-aware fine-grained fusion mechanism separately computes dense and sparse similarities for fields such as material, specification, and unit, and adaptively balances semantic and exact matching at the field level. Finally, a field-level dynamic weight learning model adjusts the contribution of different fields according to query characteristics, ensuring stable identification of target records. Experiments on a real-world dataset demonstrate that our approach significantly outperforms single-channel methods and classical baselines in ({rm{Recall@K}} ) and ({rm{MRR}} ), particularly improving robustness on specification and unit matching. The proposed framework offers a low-cost, scalable, and domain-adaptive solution, enhancing the precision and intelligence of construction cost management.},
  address = {New York, NY, USA},
  author = {Yang, Chunjun and Li, Feng and Pei, Hongxu and Tu, Cheng and Zhang, Han and Zhao, Xuechen},
  booktitle = {Proceedings of the 2025 3rd International Conference on Internet of Things and Cloud Computing Technology},
  doi = {10.1145/3776865.3776921},
  isbn = {9798400721144},
  keywords = {dual-channel fusion, engineering material matching, query enhancement, semantic retrieval},
  location = {},
  numpages = {6},
  pages = {348–353},
  publisher = {Association for Computing Machinery},
  series = {IoTCCT '25},
  title = {Intelligent Retrieval of Engineering Material Price Based on Dual-Channel Hybrid Semantic Modeling},
  url = {https://doi.org/10.1145/3776865.3776921},
  year = {2025}
}

@inproceedings{10.1145/3776942.3776983,
  abstract = {Background: Artificial intelligence (AI) technology has increasingly attracted attention in the field of psychological emotion recognition. Numerous systematic reviews and meta-analyses have been published on this topic. However, Existing research often focuses on a single aspect, such as themes, methods, or time periods. This makes it difficult for researchers to gain a comprehensive understanding of the overall progress and research hotspots in this area. Objective: This study aims to explore the development, hotspots, and emerging trends in AI-related research in psychological emotion recognition through bibliometric analysis. Method: The Web of Science Core Collection database was selected as the data source. Relevant literature on AI in psychological emotion recognition was retrieved and collected. All extracted data were imported into CiteSpace and VOSviewer for bibliometric and knowledge map analysis. Results and Conclusions: 1. A total of 648 articles were included. The annual publication volume shows a fluctuating upward trend. China is the leading country in publication output, with the Chinese Academy of Sciences and its affiliated universities as the most active institutions. The authors are relatively dispersed across the field.  2. Analysis of co-citation networks and journals indicates that research primarily focuses on databases, neural network architectures, and emotions within AI for psychological emotion recognition. 3. High-frequency keywords revolve around eight main areas: diseases, functional magnetic resonance imaging (fMRI), anterior cingulate cortex, deep learning, random forests, emotion computing, attention, and cognitive control. Facial expressions, deep learning, and the brain are the most prominent research hotspots.  4. Future trends are likely to include multimodal emotion analysis and solutions for specific mental health issues.},
  address = {New York, NY, USA},
  author = {Wang, Yan and Shen, Xunbing},
  booktitle = {Proceedings of the 2025 11th Annual International Conference on Network and Information Systems for Computers},
  doi = {10.1145/3776942.3776983},
  isbn = {9798400715839},
  keywords = {Artificial intelligence, Citespace, Deep learning, Emotion recognition, Psychology, VOSviewer},
  location = {},
  numpages = {10},
  pages = {76–85},
  publisher = {Association for Computing Machinery},
  series = {ICNISC '25},
  title = {Visualization Analysis of Artificial Intelligence Applications in Psychological Emotion Recognition Over the Past Two Decades},
  url = {https://doi.org/10.1145/3776942.3776983},
  year = {2025}
}

@inproceedings{10.1145/3777555.3777558,
  abstract = {Parkinson’s disease is the fastest growing neurodegenerative disease worldwide currently. According to American Parkinson’s Disease Association, more than 10 million people are affected from this disease in different regions globally. This number is expected to increase to around 20 million in the coming decade. Risk management through early prediction can improve these outcomes but the clinical dependency now largely focuses on subjective examination which often delay the treatment and thereby worsens the condition of the patient. These current methods lack both explainability and interpretability, which is very important in neurodegenerative diseases. Our proposed method introduces a comprehensive framework that is created by integrating high performing machine learning algorithm with explainable artificial intelligence (XAI) and large language model (LLM). It targets to produce predictive accuracy and explainability. This entire system is easily understandable through user interface to the clinical users and patients. Our proposed method started with data preprocessing. After that we extracted the features using systematic evaluation of multiple classifiers. The test results showed that the XGBoost method outperformed other models in terms of accuracy, F1-score, precision, recall, and AUC. But only this prediction scores lacked explainability. To remove this limitations of traditional machine learning algorithms we applied SHAP (SHapley Additive exPlanations) to determine the feature-wise contribution of model predictions that how much influence a feature does have in occurring an individual patient’s parkinson disease. It is patient specific and transparent. It demonstrates the reason of Parkinson’s disease feature wise. Furthermore, we extended this explainability by integrating it with Meta-LLaMa-3 that transforms the SHAP results into natural language clinical explanation through an user interface. It shows the predictive reasons of the Parkinson’s disease and confidence score of having the risk of the disease to the physicians and the patient as a outcome.The proposed framework achieves quite a few benefits by connecting the intermissions between machine learning predictions and real world clinical usability. From determining the disease to explaining the reason why it affected the patient, we also converted it to a user friendly natural language output interface for easy understanding. Most of the previous studies were only focused on predictive accuracy, but our framework uniquely vocal biomarkers and translates these patterns into neurologist-oriented natural language explanations to give a perfect output.},
  address = {New York, NY, USA},
  author = {Biswas, Avishek and Pal, Prashanta and Bhattacharjee, Shawon and Debnath, Shuvro and Chowdhury, Shafqat Nawaz and Saha, Rahul},
  booktitle = {Proceedings of the 12th International Conference on Next Generation Computing, Communication, Systems and Security},
  doi = {10.1145/3777555.3777558},
  isbn = {9798400721229},
  keywords = {Parkinson’s disease; Explainable AI; SHAP; XGBoost; Large Language Models; Clinical decision support; Neurodegenerative disorders},
  location = {},
  numpages = {8},
  pages = {8–15},
  publisher = {Association for Computing Machinery},
  series = {NSysS '25},
  title = {An Explainable AI Framework for Parkinson’s Disease Prediction Using XGBoost, SHAP, and Large Language Model Integration},
  url = {https://doi.org/10.1145/3777555.3777558},
  year = {2025}
}

@inproceedings{10.1145/3777730.3777760,
  abstract = {The rise of the low-altitude economy has introduced new challenges in human resource management, particularly in identifying and modeling competencies for emerging technical roles such as UAV operators, airspace analysts, and logistics coordinators. Conventional competency profiling methods are limited by subjectivity and lack scalability in dynamic industrial settings. To address this, we propose an intelligent, data-driven framework that integrates BERT-based semantic embeddings, unsupervised clustering, and supervised machine learning models to identify and predict role-specific competency patterns. Drawing on 2,000 job postings and 520 HR-labeled profiles, we cluster latent skill domains and build an XGBoost classifier to predict job-role alignment. SHAP analysis is employed to enhance interpretability by revealing key feature contributions. Empirical results show that the proposed framework achieves an average F1-score above 0.80 and effectively differentiates roles based on technical skillsets. The study demonstrates the feasibility of using AI-driven methods to support recruitment, training design, and workforce planning in the low-altitude economy and provides a replicable template for intelligent competency modeling in other fast-evolving sectors.},
  address = {New York, NY, USA},
  author = {Chen, Nanjing and Mao, Jiayi and Zhang, Xuming},
  booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
  doi = {10.1145/3777730.3777760},
  isbn = {9798400718540},
  keywords = {BERT embeddings, Human resource analytics, Low-altitude economy, SHAP interpretability, competency profiling, machine learning},
  location = {},
  numpages = {6},
  pages = {179–184},
  publisher = {Association for Computing Machinery},
  series = {AIVRID '25},
  title = {Profiling Key Competencies in the Low-Altitude Economy Through Machine Learning},
  url = {https://doi.org/10.1145/3777730.3777760},
  year = {2026}
}

@inproceedings{10.1145/3777730.3777849,
  abstract = {With the rapid advancement of generative artificial intelligence (gAI), spatial design is undergoing a paradigm shift from rule-based and procedural workflows toward intelligent, adaptive, and collaborative creation. This study proposes a systematic generative AI-driven design framework for exhibition spaces that integrates thematic modeling, multimodal prompt reasoning, and multi-objective optimization. The framework transforms curatorial intent and audience needs into structured inputs to generate feasible, semantically coherent, and human-aligned exhibition layouts. A hybrid optimization model is employed to balance accessibility, narrative consistency, immersion, cost, and energy efficiency, while an iterative human–AI co-design mechanism enhances adaptability and interpretability. Experimental results demonstrate that the proposed method achieves superior performance over traditional and deep generative baselines in both design quality and convergence efficiency, improving mean objective performance by over 25%. Furthermore, user studies confirm enhanced designer trust and control through visual–semantic interpretability. Overall, this research establishes a comprehensive methodology for intelligent, explainable, and efficient exhibition space design, providing a theoretical and practical foundation for future applications of gAI in architectural and spatial design.},
  address = {New York, NY, USA},
  author = {Fan, Jiaqian},
  booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence, Virtual Reality and Interaction Design},
  doi = {10.1145/3777730.3777849},
  isbn = {9798400718540},
  keywords = {Generative Artificial Intelligence, Exhibition Design, Multi-Objective Optimization},
  location = {},
  numpages = {8},
  pages = {744–751},
  publisher = {Association for Computing Machinery},
  series = {AIVRID '25},
  title = {The Design Method of Generative Artificial Intelligence for Exhibition Spaces},
  url = {https://doi.org/10.1145/3777730.3777849},
  year = {2026}
}

@inproceedings{10.1145/3777867.3777870,
  abstract = {Traditional methods of exam evaluation are often time-consuming, subjective, and prone to inconsistency and biases due to human participation. This research begins with a comparative study between different language models, highlighting the behavior and performance of different language models in evaluating short subjective answers. We compare both SLMs and LLMs, such as LLaMA, Gemma, Phi, and others, to see how effective they are in automating the grading process. After this comparative analysis, two additional experiments are performed to improve grading precision: the first is fine-tuning the GPT 3.5-Turbo model on domain-specific grading datasets to better match model predictions with human evaluators. The second experiment checks for RAG, where the GPT-4 model has access to external educational resources like subject-specific textbooks/reference books to enhance contextual understanding. The findings provide insight into the relative strengths of each strategy and blending generative AI with domain-specific enhancement for accurate, scalable, and equitable evaluation in education.},
  address = {New York, NY, USA},
  author = {Samant, Tanmayi and Bhole, Girish and Udmale, Sandeep},
  booktitle = {Proceedings of the 17th Annual Meeting of the Forum for Information Retrieval Evaluation},
  doi = {10.1145/3777867.3777870},
  isbn = {9798400723247},
  keywords = {AI in Education, Artificial intelligence, Automated Exam Evaluation, Educational Technology, Essay Scoring, Generative AI, Large Language Models (LLMs), Small language model (SLM), Retrieval-Augmented Generation (RAG), Subjective Answer Assessment},
  location = {},
  numpages = {6},
  pages = {65–70},
  publisher = {Association for Computing Machinery},
  series = {FIRE '25},
  title = {Automating Exam Evaluation Using Generative AI (GenAI)},
  url = {https://doi.org/10.1145/3777867.3777870},
  year = {2026}
}

@inproceedings{10.1145/3777867.3777879,
  abstract = {Transformer-based language models like BERT have transformed NLP through their deep contextualized embeddings. However, the layer-wise evolution of these embeddings remains underexplored, especially in narrative rich domains like Indian mythology, where prominent personalities or characters undergo semantic progression over time. In this paper, we present a continuous-time framework to model the dynamics of character embeddings from the Indian epic Mahabharata. We treat BERT’s embedding transitions as trajectories in a latent dynamical system governed by ordinary differential equations, and propose a Physics-Informed Neural Network (PINN) that incorporates narrative metadata to regularize this evolution. Experiments on six major characters, each playing a pivotal role in the narrative, reveal that contextual embeddings evolve smoothly and predictably across layers. Our PINN model aligns closely with true embeddings while maintaining interpretability through constraints like smoothness, norm conservation, and narrative consistency. This framework bridges neural model interpretability with cultural narrative analysis, opening new directions for temporally-aware NLP and domain-specific embedding modeling.},
  address = {New York, NY, USA},
  author = {Paul, Apurba and Goswami, Anish and Mahata, Sainik Kumar and Das, Dipankar},
  booktitle = {Proceedings of the 17th Annual Meeting of the Forum for Information Retrieval Evaluation},
  doi = {10.1145/3777867.3777879},
  isbn = {9798400723247},
  keywords = {BERT embeddings, Physics-Informed Neural Networks, Mahabharata, semantic dynamics, narrative modeling},
  location = {},
  numpages = {8},
  pages = {124–131},
  publisher = {Association for Computing Machinery},
  series = {FIRE '25},
  title = {Dynamics of Character Embeddings in Indian Mythology: A Physics-Informed Neural Networks Approach},
  url = {https://doi.org/10.1145/3777867.3777879},
  year = {2026}
}

@inproceedings{10.1145/3778450.3778452,
  abstract = {The exponential growth of online recruitment platforms has created significant challenges in efficiently matching candidates with suitable positions, as traditional keyword-based approaches fail to capture semantic nuances in resume content. This research presents a novel deep learning-based intelligent resume-position matching system that leverages an enhanced BERT architecture with multi-dimensional feature fusion to address these limitations. The proposed model employs a dual-tower BERT structure with weight sharing, incorporating concatenation, element-wise difference, and product operations to capture comprehensive semantic relationships between resumes and job descriptions. Experimental evaluation on a dataset of 50,000 resume-job pairs demonstrates that the system achieves an F1-score of 0.910, representing a 15.85% improvement over standard BERT-base models (0.866) and substantially outperforming traditional methods, including TF-IDF (0.716) and Word2Vec (0.757). The ablation study reveals that the complete model configuration yields a 5.8% performance gain through component integration, while maintaining consistent performance across experience levels with F1-scores ranging from 0.888 to 0.927. Case analysis further validates the model's discriminative capability, achieving an average matching score of 0.920 for successful matches compared to 0.385 for mismatched pairs. The system demonstrates practical deployment feasibility with processing speeds of 1,000 resumes per minute while maintaining accuracy, making it suitable for large-scale recruitment operations. The proposed approach effectively addresses semantic understanding challenges in recruitment, offering practical solutions for organizations managing massive applicant databases.},
  address = {New York, NY, USA},
  author = {Liu, Xuezhao},
  booktitle = {Proceedings of the 2025 International Symposium on Machine Learning and Social Computing},
  doi = {10.1145/3778450.3778452},
  isbn = {9798400721274},
  keywords = {BERT model, deep learning, feature fusion, resume-job matching, semantic matching},
  location = {},
  numpages = {6},
  pages = {8–13},
  publisher = {Association for Computing Machinery},
  series = {MLSC '25},
  title = {Deep Learning-Based Intelligent Resume-Position Matching System: Semantic Understanding and Recommendation of BERT Model in Massive Recruitment Data},
  url = {https://doi.org/10.1145/3778450.3778452},
  year = {2025}
}

@inproceedings{10.1145/3778450.3778467,
  abstract = {Under the strategic frameworks of “Education Informatization 2.0” and “Digital China,” university libraries are accelerating their transformation into intelligent knowledge hubs, with precision services emerging as their core development strategy. This paper, based on big data principles, conducts an in-depth analysis of the challenges university libraries face in areas such as data governance, technology application, talent development, ethical standards, and organizational mechanisms. Building on this analysis, a precision service model integrating cutting-edge computer technologies is proposed, along with specific implementation strategies across six dimensions: data ecosystem construction, user profiling, intelligent product development, talent cultivation planning, assessment mechanism improvement, and strengthened ethical safeguards [1] [2] [3]. Research indicates that integrating big data, knowledge graphs, and generative AI can significantly enhance resource matching efficiency (experiments show a 37.6% improvement in Top-5 recommendation accuracy), thereby redefining the library's role as a bridge in teaching and research. However, challenges such as data integration complexity, privacy protection, and interdepartmental collaboration remain major constraints. This paper provides a technical framework and implementation path for university library digital transformation that combines theoretical depth with practical feasibility.},
  address = {New York, NY, USA},
  author = {Huang, Weining},
  booktitle = {Proceedings of the 2025 International Symposium on Machine Learning and Social Computing},
