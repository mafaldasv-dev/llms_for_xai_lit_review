  pages = {104–108},
  publisher = {Association for Computing Machinery},
  series = {MLSC '25},
  title = {Research on Precise Service Models and Strategies for University Libraries Driven by Big Data},
  url = {https://doi.org/10.1145/3778450.3778467},
  year = {2025}
}

@inproceedings{10.1145/3778450.3778479,
  abstract = {Sentiment analysis is crucial for e-commerce recommendations, yet sentence-level methods ignore fine-grained distinctions, while aspect-level methods not only sacrifice interpretability but also underutilize aspect-level information. To address these limitations, we propose a dual-granularity framework with dynamic weight fusion: a BERT-CNN-LSTM captures sentence-level sentiment, while a random forest refines aspect-level BERT representations and generates interpretable decision paths. These semantic and logical features are fused based on model confidence. Experiments on the ALL Beauty and Yelp datasets show that our framework consistently outperforms existing methods, achieving improvements of 1.0 and 1.1 in ACC and 2.3 and 1.5 in F1, while enhancing interpretability through path vectorization.},
  address = {New York, NY, USA},
  author = {Liu, Yanyan and Zhang, Quan},
