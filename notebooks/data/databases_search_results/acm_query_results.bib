  title = {Deep Learning-Driven Sustainable Design for Urban Historical and Cultural District Revitalization Based on UNdata Environment Datasets},
  url = {https://doi.org/10.1145/3766671.3766719},
  year = {2025}
}

@inproceedings{10.1145/3766671.3766866,
  abstract = {In this paper, we propose a multimodal deep learning model based on a hybrid RNN-Transformer architecture, which innovatively combines the sequence modeling capability of RNN with the global attention mechanism of Transformer to improve the accuracy of depression detection, through the cross-modal attention of the fusion layer and the adaptive weight assignment of the decision layer.},
