  location = {},
  numpages = {5},
  pages = {581–585},
  publisher = {Association for Computing Machinery},
  series = {IECT '25},
  title = {Research on political Education Content Recommendation Model for Colleges and Universities Based on Graph Neural Networks},
  url = {https://doi.org/10.1145/3764206.3764296},
  year = {2025}
}

@inbook{10.1145/3764206.3764305,
  abstract = {Against the backdrop of a new wave of technological revolution, artificial intelligence (AI) is reshaping the education system, with its deep integration into vocational education attracting growing attention. Based on 3,112 articles from the Web of Science Core Collection published between 2015 and 2024, this study employs bibliometric tools including VOSviewer and CiteSpace to systematically analyze development trends in AI-empowered vocational education. The analysis covers publication patterns, author and institutional contributions, keyword clustering, and co-citation networks. The findings reveal that the field has entered a phase of rapid growth since 2020, forming a three-dimensional research structure of ``technological algorithms–educational practice–ethical governance." Emerging themes such as generative AI, teacher cognitive load, and instructional adaptability indicate a shift in research focus from technical feasibility to systemic adaptation. Based on these findings, the paper proposes policy recommendations including the establishment of regulatory frameworks, teacher capacity building, and innovation in industry-education integration, aiming to provide a systematic understanding and strategic guidance for future studies.},
  address = {New York, NY, USA},
  author = {Du, Gang and Yan, Peimeng},
  booktitle = {Proceedings of the 2nd International Conference on Intelligent Education and Computer Technology},
  isbn = {9798400714306},
  numpages = {6},
  pages = {636–641},
  publisher = {Association for Computing Machinery},
  title = {Visual Analysis of the Research on AI in Vocational Education: A Bibliometric Perspective},
  url = {https://doi.org/10.1145/3764206.3764305},
  year = {2025}
}

@inbook{10.1145/3764206.3764347,
  abstract = {Artificial intelligence (AI) is revolutionizing medical literature retrieval by addressing the inefficiencies of traditional keyword-based methods in the era of “New Medical Science". Confronted with information overload and stagnant knowledge updates, AI technologies—including natural language processing (NLP), knowledge graphs, and federated learning—enable semantic comprehension, dynamic knowledge discovery, and secure cross-institutional collaboration. Transformer-based models (e.g., BERT, GPT-4) enhance precision by interpreting contextual semantics, while recommendation systems personalize literature delivery through user behavior analysis. AI also safeguards integrity via plagiarism detection and blockchain-based data provenance. Challenges persist, such as terminological diversity and overreliance on AI tools, necessitating domain-specific model refinement, explainable AI frameworks, and hybrid pedagogy blending AI assistance with critical thinking training. Ethical risks are mitigated through federated learning with differential privacy and three-tier oversight. Future directions emphasize specialty-specific AI models, immersive Extended Reality (XR) learning environments, and global collaboration via initiatives like the ``Digital Silk Road" for standardized data sharing. By integrating technological innovation with interdisciplinary education, AI empowers researchers to navigate evolving medical frontiers, fostering data-knowledge dual-driven talent aligned with precision medicine and smart healthcare paradigms.},
  address = {New York, NY, USA},
  author = {Guo, Zhenzhao},
  booktitle = {Proceedings of the 2nd International Conference on Intelligent Education and Computer Technology},
  isbn = {9798400714306},
  numpages = {9},
  pages = {901–909},
  publisher = {Association for Computing Machinery},
  title = {Artificial Intelligence Empowered Literature Retrieval: Acquisition and Analysis of Scientific Information in Medical Basic Research under the New Medical Paradigm},
  url = {https://doi.org/10.1145/3764206.3764347},
  year = {2025}
}

@inproceedings{10.1145/3764727.3764744,
  abstract = {In the atmosphere of the strict regulation of finance industry, AML compliance imposes higher demands on interpretability and identification attention of transaction monitoring systems under low-sample scenario, while the current rule-based systems have the limitation of data shortage and diversiform behavior patterns. Towards this end, in this work we introduce a novel and interpretable large language model framework Meta-XAML, enhanced by meta-learning, for more intelligent and transparent AML transaction monitoring in low-shot setting. On the one hand, the task adaptive meta-learner is capable of dynamically adapting the model parameters to the heterogeneity of customer behavior and trans-jurisdictional differences. Secondly, the attribution-guided interpretation module makes attention aligned with the causal mask mechanism of Shapley value, to achieve legally traceable interpretation for high-risk transactions. Furthermore, the model also formulates the objective of prototype constraint contrast learning for better semantic alignment and more robust expression under few shots. By jointly optimizing multiple objectives loss functions, the entire model is forced to be optimized to ensure: the classification accuracy, interpretation credibility, and cross-domain generalization ability. Experiments on the AML trading dataset demonstrate that Meta-XAML achieves 8.6% F1-score gain over the state-of-the-art competitors.},
  address = {New York, NY, USA},
  author = {Xiao, Xiaojun and Zhang, Qinghe and Wang, Zhuqi},
  booktitle = {Proceedings of the 2025 International Conference on Artificial Intelligence and Digital Finance},
  doi = {10.1145/3764727.3764744},
  isbn = {9798400714955},
  keywords = {Anti-Money Laundering, Explainability, Few-Shot Learning, Large Language Models, Meta-Learning},
  location = {},
  numpages = {6},
  pages = {93–98},
  publisher = {Association for Computing Machinery},
  series = {AIDF '25},
  title = {Meta-Learning Enhanced Explainability of Large Language Models for Low-Sample Transaction Monitoring in AML Compliance},
  url = {https://doi.org/10.1145/3764727.3764744},
  year = {2025}
}

@inproceedings{10.1145/3764915.3770717,
  abstract = {A generative model is a statistical model of the joint probability distribution on a given observable variable and target variable, which can be used to "generate" random instances (outcomes) of an observation. When trained on broad and diverse data, it serves as a foundation model that reduces the training resources (e.g., time, energy, labeled samples) required for a wide range of downstream tasks. Due to recent success, such as the generative pre-trained transformer (GPT), there is ongoing excitement about foundation models. However, these models often struggle with out-of-distribution generalization and may yield unrealistic or physically invalid outputs. To address these limitations, we envision physics-guided generative foundation models (PgGenFMs), which integrate broad physical knowledge into foundation models to improve reliability and applicability. We also present a taxonomy comparing PgGenFMs to traditional models and outline strategies for embedding physical knowledge into data, training, and model design.},
  address = {New York, NY, USA},
  author = {Farhadloo, Majid and Sharma, Arun and Yang, Mingzhou and Jayaprakash, Bharat and Northrop, William and Shekhar, Shashi},
  booktitle = {Proceedings of the 1st ACM SIGSPATIAL International Workshop on Generative and Agentic AI for Multi-Modality Space-Time Intelligence},
  doi = {10.1145/3764915.3770717},
  isbn = {9798400722615},
  keywords = {physics-guided generative foundation models (PgGenFMs), physics-guided task-specific models (PgTSMs), foundation models (FMs)},
  location = {The Graduate Hotel Minneapolis, Minneapolis, MN, USA},
  numpages = {5},
  pages = {1–5},
  publisher = {Association for Computing Machinery},
  series = {GeoGenAgent '25},
  title = {Towards Physics-guided Generative Foundation Models},
  url = {https://doi.org/10.1145/3764915.3770717},
  year = {2025}
}

@inproceedings{10.1145/3764915.3770723,
  abstract = {Inferring demographic attributes such as age, sex, or income level from human mobility patterns enables critical applications such as targeted public health interventions, equitable urban planning, and personalized transportation services. Existing mobility-based demographic inference studies heavily rely on large-scale trajectory data with demographic labels, leading to limited interpretability and poor generalizability across different datasets and user groups. We propose HiCoTraj (Zero-Shot Demographic Reasoning via Hierarchical Chain-of-Thought Prompting from Trajectory), a framework that leverages LLMs' zero-shot learning and semantic understanding capabilities to perform demographic inference without labeled training data. HiCoTraj transforms trajectories into semantically rich, natural language representations by creating detailed activity chronicles and multi-scale visiting summaries. Then HiCoTraj uses a novel hierarchical chain of thought reasoning to systematically guide LLMs through three cognitive stages: factual feature extraction, behavioral pattern analysis, and demographic inference with structured output. This approach addresses the scarcity challenge of labeled demographic data while providing transparent reasoning chains. Experimental evaluation on real-world trajectory data demonstrates that HiCoTraj achieves competitive performance across multiple demographic attributes in zero-shot scenarios.},
  address = {New York, NY, USA},
  author = {Xie, Junyi and Jiao, Yuankun and Kim, Jina and Chiang, Yao-Yi and Zhao, Lingyi and Shafique, Khurram},
  booktitle = {Proceedings of the 1st ACM SIGSPATIAL International Workshop on Generative and Agentic AI for Multi-Modality Space-Time Intelligence},
  doi = {10.1145/3764915.3770723},
  isbn = {9798400722615},
  keywords = {demographic inference, large language model reasoning, trajectory analysis, chain-of-thought prompting, zero-shot learning},
  location = {The Graduate Hotel Minneapolis, Minneapolis, MN, USA},
  numpages = {5},
  pages = {49–53},
  publisher = {Association for Computing Machinery},
  series = {GeoGenAgent '25},
  title = {HiCoTraj: Zero-Shot Demographic Reasoning via Hierarchical Chain-of-Thought Prompting from Trajectory},
  url = {https://doi.org/10.1145/3764915.3770723},
  year = {2025}
}

@inproceedings{10.1145/3764920.3770604,
  abstract = {Current route searching systems prioritize efficiency over safety, exposing users to preventable hazards through outdated static data and opaque decision-making. We present MulSAFER, a multimodal safety-aware routing framework addressing these limitations through three innovations: real-time risk mapping from user-uploaded dashcam footage as Volunteered Geographic Information (VGI), fusion of accident records, traffic news, and visual data via semantic retrieval, and interpretable route explanations generated by Retrieval-Augmented Generation (RAG). The system processes real-time visual data to detect illegal parking while providing contextual explanations grounded in historical patterns. Results demonstrate that MulSAFER effectively balances route efficiency and safety, delivering transparent, data-driven guidance that adapts to dynamic urban conditions.},
  address = {New York, NY, USA},
  author = {Hung, YiWen and Li, AnSyu and Lin, ShihChun and Chen, HanChi and Lin, ChiTsun and Chen, YiChung},
  booktitle = {Proceedings of the 4th ACM SIGSPATIAL International Workshop on Searching and Mining Large Collections of Geospatial Data},
  doi = {10.1145/3764920.3770604},
  isbn = {9798400721830},
  keywords = {Road Safety, Route searching, Multimodal Data, Retrieval-Augmented Generation (RAG), Volunteered Geographic Information (VGI)},
  location = {},
  numpages = {8},
  pages = {1–8},
  publisher = {Association for Computing Machinery},
  series = {GeoSearch '25},
  title = {MulSAFER: A Framework for Extraction and Interpretation of Safe Mobility Paths from Multimodal Spatial Data},
  url = {https://doi.org/10.1145/3764920.3770604},
  year = {2025}
}

@inproceedings{10.1145/3764924.3770894,
  abstract = {Understanding the spatial and temporal dynamics of automated vehicle (AV) crash severity is critical for advancing urban mobility safety and infrastructure planning. In this work, we introduce ST-GraphNet, a spatio-temporal graph neural network framework designed to model and predict AV crash severity by using both finegrained and region-aggregated spatial graphs. Using a balanced dataset of 2,352 real-world AV-related crash reports from Texas (2024), including geospatial coordinates, crash timestamps, SAE automation levels, and narrative descriptions, we construct two complementary graph representations: (1) a fine-grained graph with individual crash events as nodes, where edges are defined via spatio-temporal proximity; and (2) a coarse-grained graph where crashes are aggregated into Hexagonal Hierarchical Spatial Indexing (H3)-based spatial cells, connected through hexagonal adjacency. Each node in the graph is enriched with multimodal data, including semantic, spatial, and temporal attributes, including textual embeddings from crash narratives using a pretrained Sentence-BERT model. We evaluate various graph neural network (GNN) architectures, such as Graph Convolutional Networks (GCN), Graph Attention Networks (GAT), NodeFormer, and Dynamic Hypergraph Neural Networks (DHGNN), to classify crash severity and predict high-risk regions. Our proposed ST-GraphNet, which utilizes a DHGNN backbone on the coarse-grained H3 graph, achieves a test accuracy of 98.81%, substantially outperforming the best finegrained model (61.4% test accuracy). These findings highlight the effectiveness of spatial aggregation, dynamic message passing, and multi-modal feature integration in capturing the complex spatio-temporal patterns underlying AV crash severity.},
  address = {New York, NY, USA},
  author = {Mimi, Mahmuda Sultana and Islam, Md Monzurul and Ghosh Tusti, Anannya and Somvanshi, Shriyank and Das, Subasish and Ye, Xinyue},
  booktitle = {Proceedings of the 1st ACM SIGSPATIAL International Workshop on Spatial Intelligence for Smart and Connected Communities},
  doi = {10.1145/3764924.3770894},
  isbn = {9798400721878},
  keywords = {spatio-temporal modeling, spatial aggregation, automated vehicle safety, crash severity prediction},
  location = {The Graduate Hotel Minneapolis, Minneapolis, MN, USA},
  numpages = {10},
  pages = {5–14},
  publisher = {Association for Computing Machinery},
  series = {SpatialConnect '25},
  title = {ST-GraphNet: A Spatio-Temporal Graph Neural Network for Understanding and Predicting Automated Vehicle Crash Severity},
  url = {https://doi.org/10.1145/3764924.3770894},
  year = {2025}
}

@inproceedings{10.1145/3764924.3770899,
  abstract = {Smart cities generate multi-source, multi-timescale datasets through traffic sensors, transit operations, land use registries, sociodemographic surveys, crash reporting systems, and environmental monitoring. These datasets hold significant potential to help decision-makers make better choices about transportation systems, yet their heterogeneity and complexity hinder their potential from being fully harnessed. Existing data visualization platforms have advanced exploratory analysis capabilities, but are often rigid, designed for single datasets or fixed workflows, and provide limited support for scenario-based planning across different contemporary transportation problems. Recently, Large Language Models (LLMs) have been explored in smart city applications; however, they are not well-suited to handling structured spatiotemporal data and often lack interpretability in outputs. To address these challenges, this study proposes an agentic LLM framework that formalizes visualization as an intermediate reasoning layer between heterogeneous datasets and planner-facing decision support to generate spatial intelligence. The framework comprises four coordinated agents (supervisor agent, visualization agent, analysis agent, and metrics agent) that replicate expert planning workflows and generate interpretable, evidence-backed insights. It is validated for the City of Peachtree Corners, GA, a smart city testbed where ten datasets spanning transit ridership, traffic conditions, land use, and community facilities were integrated to generate spatial intelligence for decision-making. Two case studies demonstrate the framework's capabilities; the first evaluates how expanding the reach of the existing autonomous vehicle shuttle system can improve accessibility, and the second illustrates how interactive large mobile displays can be placed to enhance information access for residents. Together, these results highlight how the framework lowers technical, analytical, and interpretive barriers for decision-makers, while producing actionable recommendations.},
  address = {New York, NY, USA},
  author = {Xu, Yufei and Kibria, Gulam and Peeta, Srinivas},
  booktitle = {Proceedings of the 1st ACM SIGSPATIAL International Workshop on Spatial Intelligence for Smart and Connected Communities},
