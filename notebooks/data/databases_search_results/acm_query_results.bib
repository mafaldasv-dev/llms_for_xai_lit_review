  isbn = {9798400719356},
  keywords = {artificial intelligence, aviation intelligence, flight operation control, large foundation model, risk management},
  location = {},
  numpages = {6},
  pages = {258–263},
  publisher = {Association for Computing Machinery},
  series = {AIIIP '25},
  title = {Artificial Intelligence and Large Foundation Models for Intelligent Operation Control in Civil Aviation: A Survey},
  url = {https://doi.org/10.1145/3778534.3778575},
  year = {2026}
}

@inproceedings{10.1145/3778534.3778585,
  abstract = {This research suggests four combined ways to rebuild things—bringing back the original context (using AR/VR and blockchain), fighting against algorithms (using NLP to encrypt or mess with data), rebuilding authority (experts and the public working together in a special way), and defending local culture—to make Chinese cultural identity stronger. Using about 10,000 samples from different places (2024 cultural data, CNKI, Kaggle, Baidu Index) and some tech tools (ResNet, BERT, LSTM, GNN, XGBoost, Random Forest), here's what we found: ResNet fixed things up to 93% (K-Means went from 0.45 to 0.72); the amount of NFTs for intangible heritage went up by 40%, and identity scores went up by 22% (p is less than 0.01); BERT messed with data 45% better on 20,000 XNLI texts; TikTok showed more varied stuff by 28%; the "Digital Silk Road" score went from 68 to 85 (from 2020 to 2025, ARIMA says plus or minus 3%); XGBoost worked 92% of the time, and SHAP said blockchain helped a lot (β=0.38). Being fair (AIF360 score over 0.90), keeping data private (ε=1.0), and using edge AI helped stop the effectiveness from dropping too much because of digital gaps, keeping it around 78%.},
  address = {New York, NY, USA},
  author = {Lv, Yiping},
  booktitle = {Proceedings of the 4th International Conference on Artificial Intelligence and Intelligent Information Processing},
  doi = {10.1145/3778534.3778585},
  isbn = {9798400719356},
  keywords = {Algorithmic Resistance, Chinese Cultural Identity, Digital Intelligence Technology, Reconstruction Pathways},
  location = {},
  numpages = {5},
  pages = {328–332},
  publisher = {Association for Computing Machinery},
  series = {AIIIP '25},
  title = {Pathway Study on the Consolidation of Chinese Cultural Identity under the Empowerment of Digital Intelligence Technologies},
  url = {https://doi.org/10.1145/3778534.3778585},
  year = {2026}
}

@inproceedings{10.1145/3778534.3778586,
  abstract = {Civil aviation activities become increasingly complicated, and human factors are regarded as the main cause of civil aviation safety incidents. Existing approaches are often difficult to uncover the implicit causes linking human errors to environmental contexts since scattered incident reports lack depth. We propose an Aviation Human Factors Safety Event Question Answering System (AHF-QA) which combines a structured domain-specific knowledge graph and large language model (LLM) to provide informative, professional, and trustworthy answers to pilots, safety managers, and accident investigation specialists. We first build a set of 728 aviation safety events caused by human factors from 1919–2025 covering twelve domains: fatigue, distraction, and others such as time-space disorientation. Through ontological design oriented from top downwards and partitioned into schema layer and data layer to realize its structured representation and visualization via Neo4j for clear insight. Next, we suggest an integrated architecture integrating aviation knowledge graph retrieval with the use of a huge LLM to decrease hallucination or non-understandability in response to user questions regarding civil aviation safety incidents induced by human factors. Last, we assess AHF-QA using objective benchmark metrics and questionnaires among flight pilots and aviation safety experts from Boeing as subjectively. Experimental analysis shows that our approach achieves more accurate and relevant responses compared with existing solutions, which benefit various applications related to analyzing aviation incidents rooted in human causes including risks prevention and aircraft cockpit trainings.},
  address = {New York, NY, USA},
  author = {Li, Yufei and Yang, Mingze and Cai, Zexin and Huang, Zhihao and Yang, Lei},
  booktitle = {Proceedings of the 4th International Conference on Artificial Intelligence and Intelligent Information Processing},
  doi = {10.1145/3778534.3778586},
  isbn = {9798400719356},
  keywords = {Knowledge Graph, Large Language Model, Question Answering System},
  location = {},
  numpages = {6},
  pages = {333–338},
  publisher = {Association for Computing Machinery},
  series = {AIIIP '25},
  title = {A Knowledge Graph and Large Language Model-based Question Answering System for Aviation Human Factors Safety Events},
  url = {https://doi.org/10.1145/3778534.3778586},
  year = {2026}
}

@inproceedings{10.1145/3778534.3778599,
  abstract = {AI has demonstrated unprecedented potential for advancement in mechanical engineering design optimization, particularly in key areas such as generative design, additive manufacturing, simulation acceleration, digital twins, and automated design. Algorithms automatically generate and optimize diverse design patterns, transcending the limitations of traditional topology optimization. Structural design has achieved a leap beyond human intuition. For additive manufacturing, AI leverages real-time data to intelligently optimize process parameters and defect detection, significantly enhancing production efficiency and quality. Digital twins facilitate instant communication between virtual models and actual systems, facilitating the implementation of intelligent manufacturing and predictive maintenance. While AI technology holds great potential, practical applications still face challenges such as insufficient data, model interpretability, high computational costs, a shortage of interdisciplinary talent, and ethical considerations. This article explores these challenges and proposes strategies such as data sharing, explainable AI, human-machine integration, green AI, educational reform, and ethical management. With the advancement of AI technology, mechanical design will gradually transition to a data- and model-driven phase, facilitating the growth of intelligent, flexible, and sustainable manufacturing systems and injecting new impetus into the industrial revolution.},
