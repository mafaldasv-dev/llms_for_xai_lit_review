INTELLIGENCE, COGMI},
  da = {2026-01-12},
  doi = {10.1109/CogMI62246.2024.00017},
  keywords = {explainability; computer vision; scene recognition},
  note = {6th International Conference on Cognitive Machine Intelligence,
Washington, DC, OCT 28-30, 2024},
  pages = {50-55},
  research-areas = {Computer Science},
  times-cited = {0},
  title = {Using Automated Core and Spurious Features Detection in Scene
Recognition to Explain Computer Vision Model},
