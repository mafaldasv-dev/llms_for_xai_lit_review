  earlyaccessdate = {NOV 2024},
  journal = {JOURNAL OF INTELLIGENT MANUFACTURING},
  keywords = {Generative adversarial network; Laser powder bed fusion; Melt pool
monitoring; Physics-guided machine learning; Transformer},
  keywords-plus = {PARAMETERS; DENSITY},
  month = {DEC},
