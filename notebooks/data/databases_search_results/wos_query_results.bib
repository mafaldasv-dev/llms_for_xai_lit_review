@inproceedings{WOS:001413988900052,
  abstract = {Addressing the global challenge of breast cancer, this research explores
the fusion of generative AI and the intricacies of breast cancer risk
assessment. This study seeks to bridge the technology gap between
intelligent machines and clinicians by demonstrating ChatGPT's
proficiency in reasoning The methodology employs a supervised
prompt-engineering approach to enforce detailed explanations for
