@inproceedings{WOS:001593512300559,
  abstract = {The need for transparent AI systems in sensitive domains like medicine
has become key. In this paper we present ANTIDOTE, a software suite
proposing different tools for argumentation-driven explainable
Artificial Intelligence for digital medicine. Our system offers the
following functionalities: multilingual argumentative analysis for the
medical domain, explanation extraction and generation of clinical
diagnoses, multilingual large language models for the medical domain,
and the first multilingual benchmark for medical question-answering.
Experimental results demonstrate the efficacy of ANTIDOTE across
