  author-email = {thiago@iiia.csic.es
nardine@iiia.csic.es
marco@iiia.csic.es},
  da = {2026-01-12},
  doi = {10.1007/s10458-023-09619-4},
  journal = {AUTONOMOUS AGENTS AND MULTI-AGENT SYSTEMS},
  keywords = {Norm violation; Incremental learning; Pre-trained language models;
Interpretability; Online communities},
  keywords-plus = {CONCEPT DRIFT; FRAMEWORK; EMERGENCE},
  month = {OCT},
  number = {2},
  research-areas = {Automation \& Control Systems; Computer Science},
  times-cited = {2},
  title = {A multi-scenario approach to continuously learn and understand norm
violations},
  type = {Article},
  unique-id = {WOS:001049230900002},
  volume = {37},
  web-of-science-categories = {Automation \& Control Systems; Computer Science, Artificial Intelligence},
  year = {2023}
