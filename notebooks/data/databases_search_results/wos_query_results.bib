EMNLP 2024},
  da = {2026-01-12},
  editor = {Al-Onaizan, Y and Bansal, M and Chen, YN},
  note = {29th Conference on Empirical Methods in Natural Language Processing,
Miami, FL, NOV 12-16, 2024},
  pages = {3847-3858},
  research-areas = {Computer Science; Linguistics},
  times-cited = {0},
  title = {Interpretability-based Tailored Knowledge Editing in Transformers},
  type = {Proceedings Paper},
