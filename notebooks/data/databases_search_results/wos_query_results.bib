Takeishi, Naoya, Univ Tokyo, Grad Sch Engn, Tokyo, Japan.
Kawahara, Yoshinobu, Osaka Univ, Grad Sch Informat Sci \& Technol, Osaka, Japan.},
  author = {Fujii, Keisuke and Takeishi, Naoya and Kawahara, Yoshinobu and Takeda,
Kazuya},
  author-email = {fujii@i.nagoya-u.ac.jp},
  da = {2026-01-12},
  doi = {10.1016/j.neunet.2023.11.068},
  earlyaccessdate = {DEC 2023},
  journal = {NEURAL NETWORKS},
  keywords = {Neural networks; Multi-agent imitation learning; Sports; Behavioral
analysis},
