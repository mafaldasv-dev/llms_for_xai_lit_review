@article{WOS:001619158900005,
  abstract = {Large Language Models (LLMs) remain fragile in specialized, data-scarce
domains: knowledge coverage is limited, hallucinations persist, and
reasoning is difficult to audit. We address these challenges in
dairy-goat husbandry by proposing DairyGoatQA, a path-centric,
structured RAG framework grounded in a curated domain knowledge graph
(KG). We construct DairyGoatGraph via zero-shot triple extraction from
the authoritative reference Leading Dairy Goat Breeds and Body
Conformation Identification Techniques, followed by rigorous human
verification, yielding an extensible, provenance-aware foundation for
path-level information organization and assessment. Built on this KG,
DairyGoatQA provides an end-to-end pipeline comprising question parsing,
entity/relation normalization, dynamic programming constrained multi-hop
candidate path generation, path-level scoring and ranking, and
path-aligned prompting. Treating relational paths as the basic
analytical unit makes the mapping between retrieved relation chains and
answer statements explicit and auditable, reduces hallucinations
compared with passage-level RAG or loosely constrained graph retrieval,
and improves interpretability for relation-rich knowledge such as breeds
and morphometrics. Under a no fine-tuning setting, DairyGoatQA
consistently outperforms strong baselines on expert-labeled data across
surface-level and semantic metrics, achieving a peak semantic similarity
of 0.9358. Visualized inference paths further enhance transparency and
trust. Taken together, the results show that combining path-centric
structured retrieval with a carefully verified domain KG yields an
effective and training-cost-friendly solution for specialized QA in the
dairy-goat domain.},
