  keywords = {distance; risk; ChatGPT; transformer},
  month = {JUN 25},
  number = {7},
  research-areas = {Computer Science},
  times-cited = {0},
  title = {Architectural Gaps in Generative AI: Quantifying Cognitive Risks for
Safety Applications},
  type = {Article},
