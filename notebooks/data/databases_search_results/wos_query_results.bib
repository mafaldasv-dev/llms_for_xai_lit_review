@inproceedings{WOS:001477116100051,
  abstract = {My research focuses on designing AI-driven interfaces to enhance
human-AI collaboration through improved interaction, decision-making,
and explainability. I integrate ML algorithms with interactive
visualizations to tackle challenges in exploring large datasets and
improve decision-making in tasks like oil spill and traffic anomaly
detection. My work also develops customizable interfaces for creative
writing, enabling iterative refinement of AI-generated content. To
advance explainable AI (XAI), I use LLMs to generate counterfactual
explanations, improving interpretability for non-experts. Future work
will quantify user exploration of generative models' latent spaces and
refine visualizations for counterfactual explanations, creating
intuitive, flexible, and interpretable AI systems.},
