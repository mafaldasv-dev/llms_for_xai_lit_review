  author-email = {mibaigang@nwpu.edu.cn},
  da = {2026-01-12},
  doi = {10.1016/j.aei.2025.104246},
  journal = {ADVANCED ENGINEERING INFORMATICS},
  keywords = {Airfoil Optimization; Aerodynamic Design; Large Language Model (LLM);
Multiagent system; Aerodynamic Knowledge; Retrieval-Augmented Generation
(RAG)},
  keywords-plus = {GENETIC ALGORITHM; DRAG},
