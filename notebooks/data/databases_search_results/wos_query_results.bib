  earlyaccessdate = {OCT 2025},
  journal = {NEUROCOMPUTING},
  keywords = {Retrieval-Augmented Generation; Mixture-of-Experts; Multi-Scale Trend
Decomposition; Erythromycin Fermentation Process},
  month = {DEC 7},
  research-areas = {Computer Science},
  times-cited = {0},
  title = {Multi-scale trend decomposition mixture of experts and time series
retrieval-augmented modeling for erythromycin fermentation process},
