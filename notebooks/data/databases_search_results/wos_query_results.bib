  journal = {IEEE TRANSACTIONS ON FUZZY SYSTEMS},
  keywords = {Linguistics; Decision making; Computational modeling; Semantics;
Probabilistic logic; Vectors; Adaptation models; Hesitant fuzzy
linguistic term sets; multiattribute decision-making (MADM); natural
language models; regret theory; semantic textual similarity;
semantically aware weights},
  keywords-plus = {PROSPECT-THEORY; TERM SET; RATIONAL CHOICE; FUZZY},
