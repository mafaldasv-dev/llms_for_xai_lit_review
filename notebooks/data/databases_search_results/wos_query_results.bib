freitas@manchester.ac.uk},
  booktitle = {PROCEEDINGS OF THE 18TH CONFERENCE OF THE EUROPEAN CHAPTER OF THE
ASSOCIATION FOR COMPUTATIONAL LINGUISTICS, VOL 1: LONG PAPERS},
  da = {2026-01-12},
