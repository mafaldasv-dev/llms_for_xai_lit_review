  doi = {10.3390/bdcc9100261},
  journal = {BIG DATA AND COGNITIVE COMPUTING},
  keywords = {prescriptive analytics; prescriptive platforms; advanced data analytics;
retrieval-augmented generation; graph-based retrieval-augmented
generation; large language models; generative AI; genAI; recommender
system},
  month = {OCT 15},
  number = {10},
  research-areas = {Computer Science},
  times-cited = {0},
  title = {Integrating Graph Retrieval-Augmented Generation into Prescriptive
Recommender Systems},
  type = {Article},
