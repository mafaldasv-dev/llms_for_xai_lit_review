  da = {2026-01-12},
  doi = {10.1007/s12065-025-01115-w},
  journal = {EVOLUTIONARY INTELLIGENCE},
  keywords = {Adaptive large neighborhood search; Variational autoencoders; Vehicle
routing problem; Heuristics; Generalization},
  keywords-plus = {TABU SEARCH; GENETIC ALGORITHM; ROUTING-PROBLEMS},
  month = {DEC 19},
  number = {1},
