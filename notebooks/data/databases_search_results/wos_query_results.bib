@inproceedings{WOS:001525524600045,
  abstract = {As generative AI systems become increasingly integrated into realworld
applications, the need to analyze and interpret their outputs grows in
importance. This paper addresses the challenge of assessing whether
generative outputs exhibit specific characteristics-such as toxicity, a
certain sentiment, or bias. We borrow a concept from the traditional
Explainable AI literature- counterfactual explanations- but argue that
it needs to be significantly rethought. We propose a flexible framework
