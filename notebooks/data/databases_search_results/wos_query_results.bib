  keywords = {Recommendation systems; explainable AI; language models},
  month = {NOV},
  number = {5},
  research-areas = {Computer Science},
  times-cited = {2},
  title = {DIRECT: Dual Interpretable Recommendation with Multi-aspect Word
Attribution},
