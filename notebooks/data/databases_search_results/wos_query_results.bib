and Evgeniou, Theodoros},
  author-email = {david.martens@uantwerpen.be},
  da = {2026-01-12},
  doi = {10.1016/j.dss.2025.114402},
  earlyaccessdate = {FEB 2025},
  journal = {DECISION SUPPORT SYSTEMS},
  keywords = {Explainable AI; Counterfactual explanations; SHAP; Large Language
Models; XAIstories},
  keywords-plus = {THEORETICAL FOUNDATIONS; SYSTEM EXPLANATIONS; DECISIONS; AI},
  month = {APR},
  research-areas = {Computer Science; Operations Research \& Management Science},
  times-cited = {5},
  title = {Tell me a story! Narrative-driven XAI with Large Language Models},
  type = {Article},
  unique-id = {WOS:001423571900001},
  volume = {191},
  web-of-science-categories = {Computer Science, Artificial Intelligence; Computer Science, Information
