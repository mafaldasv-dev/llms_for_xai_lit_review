  journal = {IEEE TRANSACTIONS ON NEURAL NETWORKS AND LEARNING SYSTEMS},
  keywords = {Deep learning; latent variable models; machine learning; model
interpretability; partial least squares (PLSs)},
  month = {NOV},
  number = {11},
