  doi = {10.1016/j.inffus.2025.102966},
  earlyaccessdate = {FEB 2025},
  journal = {INFORMATION FUSION},
  keywords = {Emotion recognition; Sentence sequence classification; Personalization;
Data cartography; Natural Language Processing (NLP); Explainable
artificial; Intelligence (XAI)},
  keywords-plus = {BASIC EMOTIONS; CLASSIFICATION; SIMILARITY; MODEL},
  month = {JUN},
  research-areas = {Computer Science},
  times-cited = {3},
  title = {Integrating personalized and contextual information in fine-grained
