  keywords = {pre-trained language models; legal domain pre-training},
  keywords-plus = {IDENTIFICATION},
  note = {19th International Conference on Artificial Intelligence and Law
(ICAIL), Univ Minho Law Sch, Braga, PORTUGAL, JUN 19-23, 2023},
