@inproceedings{WOS:001575462500213,
  abstract = {By integrating Large Language Models (LLMs) into AutoML workflows, this
study presents an integrated framework that aims to make accessible
machine learning by empowering non-technical users to handle data
preprocessing, model selection, hyperparameter optimization, and result
interpretation through natural language interactions. By automating
every step of the machine learning pipeline, the suggested system
removes technological obstacles. In comparison to state-of-the-art
