  da = {2026-01-12},
  editor = {Chen, B and Liu, S and Pilanci, M and Su, W and Sulam, J and Wang, Y and Zhu, Z},
  note = {2nd Conference on Parsimony and Learning-CPAL-Annual, Stanford
University, Stanford, CA, MAR 24-27, 2025},
  pages = {810-836},
  research-areas = {Computer Science},
  series = {Proceedings of Machine Learning Research},
