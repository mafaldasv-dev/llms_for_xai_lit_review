  journal = {IEEE TRANSACTIONS ON KNOWLEDGE AND DATA ENGINEERING},
  keywords = {Natural language processing (NLP); educational NLP; educational
applications; educational applications; question answering; question
answering; question construction; question construction; automated
assessment; automated assessment; error correction; error correction;
survey; survey; survey},
  keywords-plus = {REPAIR},
