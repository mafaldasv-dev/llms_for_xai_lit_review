  journal = {ARTIFICIAL INTELLIGENCE REVIEW},
  keywords = {Survey; Attention mechanism; Neural networks; Deep learning; Attention
models},
  keywords-plus = {GENERATIVE ADVERSARIAL NETWORK; SHORT-TERM-MEMORY; SELECTIVE ATTENTION;
RECURRENT ATTENTION; SPATIOTEMPORAL ATTENTION; VISUAL-ATTENTION;
SELF-ATTENTION; IMAGE; RECOGNITION; FUSION},
