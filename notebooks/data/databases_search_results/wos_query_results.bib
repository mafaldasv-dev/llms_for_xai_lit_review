@inproceedings{WOS:001429038200043,
  abstract = {This paper explores a hybrid approach to the multimodal co-construction
of explanations for robot faults, integrating Inductive Logic
Programming (ILP) and Large Language Models (LLMs). As AI and robotics
continue to permeate various aspects of daily life, the ability of these
systems to explain their actions and failures is crucial for fostering
user trust and ensuring safe interactions. We propose a framework that
