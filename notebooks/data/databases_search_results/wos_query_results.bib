@inproceedings{WOS:001481122200160,
  abstract = {Stock market prediction is a crucial yet challenging task due to the
inherent volatility and complexity of financial markets. Traditional
predictive models that rely solely on historical price data often fail
to capture external influences, such as public sentiment and market
psychology. In this work, we integrate sentiment analysis from financial
news and social media with advanced machine learning models to improve
stock trend forecasting. Using datasets such as Combined\_News\_DJIA,
RedditNews, and historical stock prices, we extract sentiment-driven
features and combine them with conventional stock market indicators. We
evaluate four machine learning models-Long Short-Term Memory (LSTM),
Logistic Regression, Random Forest, and Support Vector Machine
(SVM)-along with BERT (Bidirectional Encoder Representations from
Transformers) for sentiment analysis to determine their effectiveness in
sentiment-augmented stock market forecasting.
Our experimental results indicate that models incorporating sentiment
data outperform traditional price-based models. The BERT-based sentiment
model achieved the highest accuracy (98.92\%), demonstrating the
effectiveness of deep-learning-driven sentiment extraction. Meanwhile,
SVM was the best-performing traditional model (98.48\%), effectively
handling high-dimensional sentiment features. The LSTM model excelled in
capturing sequential dependencies in stock price fluctuations, while
Random Forest provided better interpretability through feature
importance analysis. This study contributes to AI-driven financial
forecasting by providing an empirical comparison of sentiment-enhanced
machine learning models and highlights the potential of real-time
sentiment monitoring for stock prediction.},
  affiliation = {Agrawal, M (Corresponding Author), UNC Charlotte, Dept Comp Engn, Charlotte, NC 28223 USA.
Agrawal, Manan; Mukherjee, Arindam, UNC Charlotte, Dept Comp Engn, Charlotte, NC 28223 USA.},
