  earlyaccessdate = {NOV 2025},
  journal = {ADVANCED ENGINEERING INFORMATICS},
  keywords = {Human-AI Collaboration; LLMs; XAI; Layered Heterogeneous Network},
  keywords-plus = {CERTAINTY},
  month = {NOV},
  number = {A},
  research-areas = {Computer Science; Engineering},
  times-cited = {0},
  title = {Uncertainty reports as explainable AI: A cognitive-adaptive framework
for human-AI decision systems in context tasks},
  type = {Article},
  unique-id = {WOS:001534873000001},
  volume = {68},
  web-of-science-categories = {Computer Science, Artificial Intelligence; Engineering,
