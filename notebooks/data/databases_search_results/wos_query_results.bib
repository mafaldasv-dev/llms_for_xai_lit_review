sks.cse@iitbhu.ac.in},
  da = {2026-01-12},
  doi = {10.1016/j.eswa.2024.125997},
  earlyaccessdate = {DEC 2024},
  journal = {EXPERT SYSTEMS WITH APPLICATIONS},
  keywords = {Drug discovery; Continual learning; Catastrophic forgetting; Multi-task
learner; Explainable Artificial Intelligence (XAI); Simplified Input
Line Entry System (SMILES)},
  keywords-plus = {DISCOVERY; MODELS; DRUGS},
  month = {APR 1},
  research-areas = {Computer Science; Engineering; Operations Research \& Management Science},
