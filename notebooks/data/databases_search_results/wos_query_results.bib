  keywords = {Stock Market Prediction; Sentiment Analysis; Financial News; Machine
Learning; LSTM; Support Vector Machine (SVM); Random Forest; Logistic
Regression; BERT; Time-Series Data; AI in Finance; NLP; Predictive
Analytics},
