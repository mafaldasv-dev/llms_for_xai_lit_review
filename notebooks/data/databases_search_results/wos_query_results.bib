  keywords = {explainable; artificial intelligence; brain; machine learning;
navigation; spatial learning},
  keywords-plus = {DIRECTION; HIPPOCAMPUS; CORTEX},
  note = {Conference on Disruptive Technologies in Information Sciences VII,
Orlando, FL, MAY 01-03, 2023},
  research-areas = {Computer Science},
