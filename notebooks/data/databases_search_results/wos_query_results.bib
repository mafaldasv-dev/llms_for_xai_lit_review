@inproceedings{WOS:001477477000237,
  abstract = {We present TRACE-CS, a novel hybrid system that combines symbolic
reasoning with large language models (LLMs) to address contrastive
queries in scheduling problems. TRACE-CS leverages SAT solving
techniques to encode scheduling constraints and generate explanations
