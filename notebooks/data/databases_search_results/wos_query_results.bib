@article{WOS:001517296700006,
  abstract = {Traffic safety analysis has traditionally relied on tabular crash data,
featuring variables in categorical or numeric forms. However, the
conventional statistical approaches have inherent limitations in
capturing intricate nonlinear feature interactions and struggle with the
scales of large datasets available today. Consequently, modern machine
learning techniques, especially tree ensembles, have emerged as dominant
tools for analyzing tabular data due to their predictive capability and
interpretability. Despite these advances, relying solely on preprocessed
tabular data, structured through human-crafted coding, can lead to
significant information loss, particularly when the nuances of crash
narratives are not fully captured. To address this issue, we introduce a
novel multi-modal framework that integrates both tabular data and
descriptive narratives for enhanced traffic safety modeling. Our
approach employs pre-trained Large Language Models (LLMs) to process
textual narratives generated from structured tabular crash data using a
template-based construction technique. The constructed textual narrative
captures the rich contextual details about each crash event, enabling
LLMs to bridge the information gap and provide a more holistic
understanding of crash dynamics. Our experiments, centered on crash
severity modeling, demonstrate the superior performance of the proposed
multi-modal paradigm over classic baselines such as boosted tree models
and standalone language models, particularly in inferring fatal and
serious crashes. Our findings highlight the potential synergy between
domain-specific knowledge in traffic safety and general knowledge
embedded in LLMs. This work represents one of the early endeavors that
integrate LLMs for enhancing traffic safety modeling, offering a
promising direction for future research and a paradigm shift in the
field.},
  affiliation = {Yang, JJ (Corresponding Author), Univ Georgia, Coll Engn, Athens 99164, GA USA.
Zhen, Hao; Yang, Jidong J., Univ Georgia, Coll Engn, Athens 99164, GA USA.},
  article-number = {128450},
  author = {Zhen, Hao and Yang, Jidong J.},
  author-email = {hao.zhen@uga.edu
jidong.yang@uga.edu},
  da = {2026-01-12},
  doi = {10.1016/j.eswa.2025.128450},
