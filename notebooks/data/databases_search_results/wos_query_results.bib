  research-areas = {Computer Science; Engineering},
  times-cited = {0},
  title = {Explainable Recommendation of Software Vulnerability Repair Based on
Metadata Retrieval and Multifaceted LLMs},
  type = {Article},
  unique-id = {WOS:001646966400001},
