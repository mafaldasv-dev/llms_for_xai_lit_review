toshild.shibahara@ntt.com
yanai@ist.osaka-u.ac.jp},
  book-group-author = {ASSOC COMPUTING MACHINERY},
  booktitle = {PROCEEDINGS OF THE 2ND ACM WORKSHOP ON SECURE AND TRUSTWORTHY DEEP
LEARNING SYSTEMS, SECTL 2024},
  da = {2026-01-12},
  doi = {10.1145/3665451.3665533},
  keywords = {Data-Free Model Extraction; Vanilla Gradient; Explainable AI},
  note = {2nd ACM Workshop on Secure and Trustworthy Deep Learning Systems
(SecTL), Singapore, SINGAPORE, JUL 02-20, 2024},
  pages = {56-66},
  research-areas = {Computer Science},
  times-cited = {6},
  title = {MEGEX: Data-Free Model Extraction Attack Against Gradient-Based
Explainable AI},
  type = {Proceedings Paper},
