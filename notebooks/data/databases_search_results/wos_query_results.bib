@article{WOS:001236687600021,
  abstract = {For text sentiment analysis, state-of-the-art neural language models
have demonstrated promising performance. However, they lack
interpretability, require vast volumes of annotated data, and are
typically specialized for tasks. In this article, we explore a
connection between fine-tuned Transformer models and unsupervised LDA
approach to cope with text sentiment analysis tasks, inspired by the
concept of Neuro-symbolic AI. The Transformer and LDA models are
combined as a feature extractor to extract the hidden representations of
the input text sequences. Subsequently, we employ a feedforward network
to forecast various sentiment analysis tasks, such as multi-label
emotion prediction, dialogue quality prediction, and nugget detection.
Our proposed method obtains the best results in the NTCIR-16 dialogue
evaluation (DialEval-2) task, as well as cutting-edge results in
emotional intensity prediction using the Ren\_CECps corpus. Extensive
experiments show that our proposed method is highly explainable,
cost-effective in training, and superior in terms of accuracy and
robustness.},
