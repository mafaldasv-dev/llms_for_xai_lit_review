  booktitle = {ARTIFICIAL INTELLIGENCE FOR SECURITY AND DEFENCE APPLICATIONS},
  da = {2026-01-12},
  doi = {10.1117/12.2680317},
  editor = {Bouma, H and Dijk, J and Prabhu, R and Stokes, RJ and Yitzhaky, Y},
  keywords = {Variational Autoencoder; Active Learning; Anomaly Detection; Explainable
AI; Counterfactual Explainability; Synthetic Data Generation;
Semi-Supervised Classification},
  note = {Conference on Artificial Intelligence for Security and Defence
Applications, Amsterdam, NETHERLANDS, SEP 04-05, 2023},
  research-areas = {Computer Science},
