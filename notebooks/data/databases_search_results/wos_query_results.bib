@inproceedings{WOS:001534184200005,
  abstract = {Efficient sharing of narrowband communication channels among radar and
communication signals is a critical challenge in modern systems. As
spectrum congestion intensifies, interference between these signals can
severely degrade system performance. In this work, we explore the
application of deep learning methods, specifically CNNs(1-3) and
ViTs,(4, 5) for classifying and measuring interference on narrowband
channels. We also propose an XAI approach that integrates Visual Large
Language Models (VLLMs) with saliency maps to provide interactive
explanations of model decisions.(6, 7) Our results demonstrate that ViTs
deliver superior classification accuracy across varying SNR conditions,
reflecting their ability to capture complex time-frequency
patterns.(8-10) Furthermore, the addition of explainable AI enhances
human interpretability by highlighting critical features in spectrograms
and generating coherent textual summaries.(11-13) This multimodal
explainability framework shows promise for real-time interference
mitigation, improved transparency, and accelerated decision-making in
high-stakes applications, such as defense, aviation, and emerging 5G/6G
systems.},
  affiliation = {Hinkley, B (Corresponding Author), Univ Texas San Antonio, 1 UTSA Circle, San Antonio, TX 78249 USA.
Hinkley, Bryce; Akopian, David, Univ Texas San Antonio, 1 UTSA Circle, San Antonio, TX 78249 USA.
Necsoiu, Marius, DEVCOM Army Res Lab, San Antonio, TX USA.},
