  editor = {Yang, DN and Xie, X and Tseng, VS and Pei, J and Huang, JW and Lin, JCW},
  keywords = {Vehicle Routing Problem; Explainability; Structural Causal Model;
Counterfactual Explanation; Large Language Models},
  note = {28th Pacific-Asia Conference on Knowledge Discovery and Data Mining
(PAKDD), Taipei, TAIWAN, MAY 07-10, 2024},
  pages = {30-42},
