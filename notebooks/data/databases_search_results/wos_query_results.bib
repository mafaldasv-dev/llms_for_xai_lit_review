  editor = {Finkelstein, J and Moskovitch, R and Parimbelli, E},
  keywords = {Medical CBIR; Brain Tumor Classification; Large Language Models; Deep
Learning; Contrastive Learning},
  note = {22nd International Conference on Artificial Intelligence in Medicine
(AIME), Salt Lake City, UT, JUL 09-12, 2024},
  pages = {335-349},
  research-areas = {Computer Science; Engineering; Radiology, Nuclear Medicine \& Medical
Imaging},
  series = {Lecture Notes in Artificial Intelligence},
  times-cited = {4},
  title = {Towards Interactive and Interpretable Image Retrieval-Based Diagnosis:
