  journal = {ARTIFICIAL INTELLIGENCE REVIEW},
  keywords = {Emotion recognition; Conversations; Deep learning; Sentiment analysis;
Dialogue},
  keywords-plus = {REPRESENTATIONS; AWARENESS; NETWORKS; MODEL},
  month = {NOV 7},
  number = {1},
  research-areas = {Computer Science},
  times-cited = {15},
  title = {Deep emotion recognition in textual conversations: a survey},
  type = {Article},
