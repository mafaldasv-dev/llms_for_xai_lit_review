(CVPR)},
  da = {2026-01-12},
  doi = {10.1109/CVPR52734.2025.00764},
  note = {2025 Conference on Computer Vision and Pattern Recognition-CVPR-Annual,
Nashville, TN, JUN 10-17, 2025},
  pages = {8162-8171},
  research-areas = {Computer Science},
  series = {IEEE Conference on Computer Vision and Pattern Recognition},
  times-cited = {0},
  title = {Interpretable Generative Models through Post-hoc Concept Bottlenecks},
  type = {Proceedings Paper},
  unique-id = {WOS:001601106700183},
  web-of-science-categories = {Computer Science, Artificial Intelligence; Computer Science,
