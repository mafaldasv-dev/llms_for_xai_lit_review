  da = {2026-01-12},
  doi = {10.1145/3715275.3732021},
  keywords = {Explainable AI; Human-AI Interaction; Unintuitive Features; Large;
Language Models},
  note = {8th Conference on Fairness Accountability and Transparency-FACCT,
Athens, GREECE, JUN 23-26, 2025},
  pages = {296-311},
  research-areas = {Computer Science; History \& Philosophy of Science},
