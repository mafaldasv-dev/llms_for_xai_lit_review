  keywords = {Intrusion Detection Systems; Explainable AI; Coherence; Domain-specific
Knowledge; Large Language Models; Automation; Prompt Engineering},
  note = {6th International Conference on Trust Privacy and Security in
Intelligent Systems and Applications, Washington, DC, OCT 28-31, 2024},
  pages = {87-96},
  research-areas = {Computer Science},
