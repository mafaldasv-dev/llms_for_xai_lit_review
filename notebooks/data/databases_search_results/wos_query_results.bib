  doi = {10.3390/bdcc9120312},
  journal = {BIG DATA AND COGNITIVE COMPUTING},
  keywords = {subjective assessment; disagreement analysis; natural language
processing; deep learning; defect detection; remanufacturing},
  month = {DEC 4},
