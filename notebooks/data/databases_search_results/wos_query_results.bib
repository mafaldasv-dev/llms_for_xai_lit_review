m\_anandkumar@nitk.edu.in},
  da = {2026-01-12},
  doi = {10.1007/s13042-025-02635-8},
  earlyaccessdate = {MAY 2025},
  journal = {INTERNATIONAL JOURNAL OF MACHINE LEARNING AND CYBERNETICS},
  keywords = {Fake news; Misinformation; BERT; Window; N-gram; Explainable AI;
Transformers},
  month = {SEP},
  number = {9},
  pages = {6577-6596},
  research-areas = {Computer Science},
  times-cited = {0},
  title = {LeDoFAN: enhancing lengthy document fake news identification leveraging
large language models and explainable window-based transformers with
n-gram expulsion},
