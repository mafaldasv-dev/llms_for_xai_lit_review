  keywords = {Bayesian networks; Conditional Probability Tables (CPTs); Quantum
Approx-imate Optimization Algorithm; Semantic Relationships; XLNet},
  number = {1},
  pages = {3495-3518},
  research-areas = {Computer Science},
  times-cited = {0},
  title = {Quantum LLM Model for Entity and Semantic Relation Extraction in Drug
Interactions},
