  keywords = {Semantic Text Similarity; Transformers; eXplainable AI; Knowledge Graphs},
  note = {26th Iberoamerican Congress on Pattern Recognition (CIARP), Coimbra Inst
Engn, Coimbra, PORTUGAL, NOV 27-30, 2023},
