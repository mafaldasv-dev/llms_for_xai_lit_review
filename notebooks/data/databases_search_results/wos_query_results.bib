@article{WOS:001641552700001,
  abstract = {Decoding natural images from neural signals has long been a research
goal. While recent advances in contrastive learning and generative
models have improved visual decoding based on fMRI, fMRI's high cost and
low temporal resolution limit its practicality, driving interest in
EEG-based approaches. In this study, we propose MB-ST, a novel EEG
encoder that integrates a Frequency-Bands Decomposition Module for
frequency-domain feature extraction and a Spatial-Temporal Feature
Extraction Block for spatio-temporal feature learning. MB-ST employs
multi-band learnable filters and multi-scale convolutional kernels to
efficiently capture the complex structure of EEG signals. Extensive
experiments on the THINGS-EEG dataset demonstrate state-of-the-art
zero-shot visual decoding performance. We further validate the model's
real-time processing capability and cross-modal generalization on MEG
data.Comprehensive interpretability analyses confirm both the model
transparency and the biological relevance of the learned features.},
