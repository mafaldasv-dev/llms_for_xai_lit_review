bouraoui@cril.fr},
  book-group-author = {ACM},
  booktitle = {PROCEEDINGS OF THE 24TH INTERNATIONAL CONFERENCE ON AUTONOMOUS AGENTS
AND MULTIAGENT SYSTEMS, AAMAS 2025},
  da = {2026-01-12},
  keywords = {Embodied AI; embodied cognition; neurosymbolic AI; image schemas;
natural language understanding; agent reasoning; mental simulation},
