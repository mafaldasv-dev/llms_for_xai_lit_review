  da = {2026-01-12},
  doi = {10.3389/frai.2025.1537432},
  journal = {FRONTIERS IN ARTIFICIAL INTELLIGENCE},
  keywords = {transformer model; long short-term memory; Bengali news titles;
classification; LIME; explainable AI; machine learning; deep learning},
  month = {NOV 6},
  research-areas = {Computer Science},
