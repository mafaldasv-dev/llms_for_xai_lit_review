yan.liu@concordia.ca},
  da = {2026-01-12},
  doi = {10.3390/make7040149},
  journal = {MACHINE LEARNING AND KNOWLEDGE EXTRACTION},
  keywords = {software code vulnerability; retrieval strategy; foundation model;
explainability},
  month = {NOV 19},
