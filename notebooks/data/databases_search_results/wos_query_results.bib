  booktitle = {2024 IEEE INTERNATIONAL CONFERENCE ON MULTIMEDIA AND EXPO, ICME 2024},
  da = {2026-01-12},
  doi = {10.1109/ICME57554.2024.10687470},
  keywords = {Zero-shot; Navigation; Vision and language; Agent; Large language model},
  note = {IEEE International Conference on Multimedia and Expo (ICME), Niagra
Falls, CANADA, JUL 15-19, 2024},
  research-areas = {Computer Science},
  series = {IEEE International Conference on Multimedia and Expo},
  times-cited = {0},
  title = {TINA: THINK, INTERACTION, AND ACTION FRAMEWORK FOR ZERO-SHOT VISION
LANGUAGE NAVIGATION},
  type = {Proceedings Paper},
