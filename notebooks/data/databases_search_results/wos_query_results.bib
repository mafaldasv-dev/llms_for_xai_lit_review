  month = {JUL-AUG},
  number = {4},
  pages = {29-36},
  research-areas = {Computer Science; Engineering},
  times-cited = {1},
  title = {Leveraging Large Language Models for Autonomous Cyber Defense: Insights
from CAGE-2 Simulations},
