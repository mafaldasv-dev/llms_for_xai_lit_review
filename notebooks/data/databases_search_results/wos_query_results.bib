COMPUTATIONAL LINGUISTICS (ACL 2022), VOL 1: (LONG PAPERS)},
  da = {2026-01-12},
  note = {60th Annual Meeting of the Association-for-Computational-Linguistics
(ACL), Dublin, IRELAND, MAY 22-27, 2022},
  pages = {7787-7805},
  research-areas = {Computer Science; Linguistics},
  times-cited = {5},
  title = {Entity-based Neural Local Coherence Modeling},
  type = {Proceedings Paper},
  unique-id = {WOS:000828702307064},
