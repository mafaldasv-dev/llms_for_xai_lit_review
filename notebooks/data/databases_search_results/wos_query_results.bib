@inproceedings{WOS:001219280700017,
  abstract = {Despite deep learning techniques achieving performances for medical
image analysis tasks comparable to that of medical experts for many
problems, their clinical adoption remains limited, partially due to the
lack of reliable explainability approaches that shed light on the
models' decision-making process. The resulting need for interpretable
deep learning methods has spurred the field of explainable AI (XAI),
which includes traditional post-hoc methods and more advanced
approaches. Among these, causal generative techniques stand out due to
their ability to incorporate a causal perspective into deep learning
models that can help to move from correlation-based to causal
explainability. However, their development has predominantly been
centered on 2D images and tabulated data, limiting their applicability
in advanced medical scenarios. To overcome this limitation, we propose
an innovative method to expand a causal generative framework to handle
volumetric 3D images. Our novel strategy addresses computational
challenges in this scenario by sequentially generating image slices,
which are then fused back together into a single volume. We showcase the
suitability of this approach by analyzing the effect of brain aging
using 3D magnetic resonance imaging (MRI) data from the UK Biobank study
with a sample size of 23692 participants. The results of the evaluation
demonstrate that the proposed causal model is capable of generating 3D
brain images that convincingly depict the aging process. Overall, the
proposed technique paves the way for 3D causal generative models in
medical image analysis that can help explain other models or be used as
standalone, highly interpretable generative-discriminative models.},
