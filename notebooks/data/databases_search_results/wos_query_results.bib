  author-email = {schavan@ltu.edu
gpappas@ltu.edu},
  da = {2026-01-12},
  doi = {10.3390/ai6090214},
  journal = {AI},
  keywords = {BERT; DGCNN; MIR; KELM; Explainable AI (XAI); vulnerability detection;
DevSecOps},
  month = {SEP 4},
  number = {9},
