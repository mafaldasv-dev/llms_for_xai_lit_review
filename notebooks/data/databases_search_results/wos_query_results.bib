@article{WOS:001617982400016,
  abstract = {Phishing attacks have evolved into highly sophisticated cyber threats,
exploiting human trust and emerging digital platforms to deceive
individuals and organizations. To counteract this growing menace, we
present Stealth-Phisher, a defensive framework that combines hybrid deep
learning with generative AI (GenAI). The framework is trained on the
StealthPhisher dataset containing 336,749 records enriched with
attributes such as Shannon entropy, URL structure, Kolmogorov
complexity, and HTML-based data, ensuring coverage of various phishing
tactics. To preserve discriminative information during dimensionality
reduction, we introduce the Class-Specific Principal Component Analysis
(CSPCA), which selects features based on their variance within each
class. The learning architecture integrates a Wide \& Deep Neural
Network with a Feed-Forward Neural Network. The Wide \& Deep component
captures sparse tokens, categorical features of high cardinality, and
interactions between features, while the Feed-Forward network focuses on
CSPCA-reduced statistical attributes, modeling non-linear dependencies,
and generalizing to unseen patterns. This complementary division between
memorization and statistical reasoning improves accuracy and
interpretability. The experimental evaluation shows that StealthPhisher
achieves 99.85 \% detection accuracy and maintains 98.70\% robustness
under adversarial attacks based on Fast Gradient Sign Method (FGSM). An
adversarial evaluation module further validates the resilience of the
framework in real-world threat scenarios. In addition, GenAI is used to
generate interactive and user-friendly reports, enabling non-technical
users to interpret results and strengthen proactive defense. The
findings demonstrate that StealthPhisher surpasses existing approaches
in terms of detection accuracy, adversarial robustness, and usability,
while its modular design offers a foundation for future work against
multilingual and polymorphic phishing threats.},
  affiliation = {Prasad, A (Corresponding Author), GLA Univ, Dept Comp Engn \& Applicat, Mathura, India.
Prasad, Arvind; Yadav, Vibhu; Solanki, Chirag; Goswami, Harshit; Jha, Tanmay; Nagal, Dushyant, GLA Univ, Dept Comp Engn \& Applicat, Mathura, India.},
  article-number = {130205},
