  da = {2026-01-12},
  doi = {10.1007/978-3-032-00986-9\_22},
  editor = {Roning, J and Filipe, J},
  keywords = {Anomaly detection; Large language models; Logical anomalies; Structural
anomalies},
  note = {5th International Conference on Robotics Computer Vision and Intelligent
