ATTICUSG@GMAIL.COM},
  booktitle = {CAUSAL LEARNING AND REASONING},
  da = {2026-01-12},
  editor = {Huang, B and Drton, M},
  keywords = {causal abstraction; mechanistic interpretability; causal representation
learning},
  note = {2025 Conference on Causal Learning and Reasoning-CLEAR, Lausanne,
SWITZERLAND, MAY 07-09, 2025},
  pages = {114-138},
  research-areas = {Computer Science; Mathematics},
  series = {Proceedings of Machine Learning Research},
  times-cited = {0},
  title = {Combining Causal Models for More Accurate Abstractions of Neural
