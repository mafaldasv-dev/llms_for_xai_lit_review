  journal = {ACM TRANSACTIONS ON ASIAN AND LOW-RESOURCE LANGUAGE INFORMATION
PROCESSING},
  keywords = {Attention mechanism; cross-lingual representation; deep learning;
transformers; low-resource languages; sentiment analysis},
  month = {NOV},
  number = {11},
  research-areas = {Computer Science},
  times-cited = {2},
  title = {How a Deep Contextualized Representation and Attention Mechanism
Justifies Explainable Cross-Lingual Sentiment Analysis},
