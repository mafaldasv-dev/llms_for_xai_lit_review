  da = {2026-01-12},
  doi = {10.1109/IJCNN60899.2024.10651416},
  keywords = {Alzheimer disease; vision transformer; BERT; Multi-modal data; LRP;
LIME.},
  keywords-plus = {ASSOCIATION WORKGROUPS; NATIONAL INSTITUTE; RECOMMENDATIONS; GUIDELINES;
