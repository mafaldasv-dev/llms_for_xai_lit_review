  da = {2026-01-12},
  editor = {Rogers, A and Boyd-Graber, J and Okazaki, N},
  note = {61st Annual Meeting of the the Association-for-Computational-Linguistics
(ACL), Toronto, CANADA, JUL 09-14, 2023},
  pages = {9103-9125},
  research-areas = {Computer Science},
  times-cited = {5},
  title = {Backpack Language Models},
