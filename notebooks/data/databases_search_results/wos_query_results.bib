  journal = {IEEE TRANSACTIONS ON NEURAL NETWORKS AND LEARNING SYSTEMS},
  keywords = {Predictive models; Graph neural networks; Deep learning; Data models;
Decision making; Computational modeling; Complexity theory; Analytical
models; Vectors; Training; explainable artificial intelligence; neural
networks},
  month = {NOV},
  number = {11},
  pages = {19775-19789},
  research-areas = {Computer Science; Engineering},
  times-cited = {0},
  title = {Gen-GraphEx: Generative In-Distribution Graph Explanations for
Time-Efficient Model-Level Interpretability of GNNs},
