@article{WOS:001558930800001,
  abstract = {The proliferation of generative AI has significantly enhanced deceptive
review tactics, posing a critical threat to the integrity of e-commerce
platforms. Our study addresses this challenge by integrating information
manipulation theory (IMT) with explainable AI techniques to develop a
transparent and effective framework for detecting AI-generated deceptive
reviews. We systematically generated manipulated reviews using multiple
AIbased approaches-real-based generation, fake-based generation, and
user-guided-to replicate real-world review fraud scenarios. The primary
evaluation focused on detecting mixed manipulated reviews (MMR) versus
real reviews, reflecting the complex nature of contemporary online
deception in which multiple manipulation strategies coexist. Our
findings indicate that features associated with the relation dimension
of IMT were particularly effective in distinguishing manipulated content
from authentic reviews. The integration of newly adopted features,
categorized under all IMT dimensions, contributed to improved detection
performance across all types of manipulated reviews, highlighting the
strength of a theory-driven and explainable approach. Features related
to the relation dimension, such as ``Customer Service and
Friendliness{''} and ``Restaurant Atmosphere,{''} were highlighted
through interpretability analysis as prominent indicators of deception,
pointing to exaggerated positivity as a common strategy in manipulated
reviews. These results highlight the increasing sophistication of
AI-generated reviews and the pressing need for robust detection
frameworks. This study offers a theoretically grounded and empirically
validated approach to AI-driven deception detection and provides
valuable insights for businesses, regulatory bodies, and online
platforms. Our findings contribute to the development of advanced tools
for preserving the credibility of online review systems amid the growing
prevalence of AI-generated misinformation.},
  affiliation = {Hong, T (Corresponding Author), Pusan Natl Univ, Coll Business, Busan 46241, South Korea.
Chernyaeva, Olga; Hong, Taeho, Pusan Natl Univ, Coll Business, Busan 46241, South Korea.
Lee, One-Ki Daniel, Virginia Commonwealth Univ, Sch Business, Richmond, VA 23284 USA.},
  article-number = {114522},
  author = {Chernyaeva, Olga and Lee, One-Ki Daniel and Hong, Taeho},
  author-email = {hongth@pusan.ac.kr},
  da = {2026-01-12},
  doi = {10.1016/j.dss.2025.114522},
  journal = {DECISION SUPPORT SYSTEMS},
  keywords = {Review deception; Manipulated review detection; AI-generated text; IMP;
XAI},
  keywords-plus = {DECEPTION; LANGUAGE; PRODUCT},
  month = {OCT},
  research-areas = {Computer Science; Operations Research \& Management Science},
  times-cited = {1},
  title = {From fake to AI-generated: Leveraging information manipulation theory
and explainable AI for robust detection of manipulated reviews},
  type = {Article},
  unique-id = {WOS:001558930800001},
  volume = {197},
  web-of-science-categories = {Computer Science, Artificial Intelligence; Computer Science, Information
Systems; Operations Research \& Management Science},
  year = {2025}
}

@inproceedings{WOS:001559660000014,
  abstract = {In recent years, significant advancements in Generative Artificial
Intelligence (GenAI) have resulted in an expansion of its applications
and an increased susceptibility to cyber-attacks. These attacks can
bypass ethical guidelines and integrated protections, posing a
significant threat to cybersecurity and information integrity, such as
prompt injections aiming to produce and spread misinformation. To
develop robust cybersecurity solutions, it is essential to understand
the vulnerabilities of GenAI and analyze the characteristics of
potential attacks. This manuscript proposes a mechanism for identifying
jailbreaking prompts for manipulating Large Language Models (LLMs). The
designed process involves the interaction between an LLM Attacker and an
LLM Victim. LLM Attacker generates potential jailbreaking prompts to
induce the LLM Victim to generate unethical content. The prompts and
their corresponding persuasion success are collected during their
interaction. In this way, a new synthetic dataset of 3000 prompts has
been constructed. Such a dataset is exploited to train a new model for
detecting hidden persuasion in prompts that can induce an LLM to produce
deviating content. This new model, assisted by algorithms for
eXaplainable Artificial Intelligence (xAI), works as an anti-persuasion
filter interposed between the input prompt and the victim model. It
identifies attempts to mislead LLM and tries to neutralize them by
modifying words recognized as crucial by xAI algorithms like SHAP and
LIME. Experimentation reveals that adopting SHAP and removing the first
ten most important words in the original prompt allows for neutralizing
80\% of persuasive prompts.},
  affiliation = {Fenza, G (Corresponding Author), Univ Salerno, Dept Management \& Innovat Syst, Fisciano, SA, Italy.
Fenza, Giuseppe; Gallo, Mariacristina; Stanzione, Claudio, Univ Salerno, Dept Management \& Innovat Syst, Fisciano, SA, Italy.
