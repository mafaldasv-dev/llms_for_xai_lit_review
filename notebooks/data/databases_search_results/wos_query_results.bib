  da = {2026-01-12},
  doi = {10.1016/j.eswa.2025.130205},
  journal = {EXPERT SYSTEMS WITH APPLICATIONS},
  keywords = {Phishing attack; Phishing attack dataset; Deep learning; GenAI;
Adversarial attacks},
