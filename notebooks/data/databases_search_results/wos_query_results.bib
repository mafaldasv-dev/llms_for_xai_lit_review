She, Zhong-Tian and Lin, Jia-Rui},
  author-email = {lin611@tsinghua.edu.cn},
  da = {2026-01-12},
  doi = {10.1016/j.engappai.2023.107207},
  earlyaccessdate = {OCT 2023},
  journal = {ENGINEERING APPLICATIONS OF ARTIFICIAL INTELLIGENCE},
  keywords = {Automated rule interpretation; Machine interpretability; Text
classification (TC); Natural language processing (NLP); Domain-specific
pretrained model; Human-machine intelligence; Smart standard},
  keywords-plus = {RULE CHECKING},
  month = {JAN},
  number = {A},
  research-areas = {Automation \& Control Systems; Computer Science; Engineering},
  times-cited = {27},
  title = {A text classification-based approach for evaluating and enhancing the
machine interpretability of building codes},
