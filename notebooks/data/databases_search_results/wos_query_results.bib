  author-email = {mhcupb@163.com},
  da = {2026-01-12},
  doi = {10.1016/j.neunet.2024.106345},
  earlyaccessdate = {MAY 2024},
  journal = {NEURAL NETWORKS},
  keywords = {Multivariate time series classification; Explainable artificial
