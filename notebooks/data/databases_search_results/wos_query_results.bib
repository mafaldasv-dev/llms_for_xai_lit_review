@inproceedings{WOS:001567374700102,
  abstract = {Topic modeling is a crucial technique for extracting latent themes from
unstructured text data, particularly valuable in analyzing survey
responses. However, traditional methods often only consider free-text
responses and do not natively incorporate structured or categorical
survey responses for topic modeling. And they produce abstract topics,
requiring extensive human interpretation. To address these limitations,
we propose the Multi-Agent LLM Topic Modeling Framework (MALTopic). This
framework decomposes topic modeling into specialized tasks executed by
individual LLM agents: an enrichment agent leverages structured data to
enhance textual responses, a topic modeling agent extracts latent
themes, and a deduplication agent refines the results. Comparative
analysis on a survey dataset demonstrates that MALTopic significantly
improves topic coherence, diversity, and interpretability compared to
LDA and BERTopic. By integrating structured data and employing a
multi-agent approach, MALTopic generates human-readable topics with
enhanced contextual relevance, offering a more effective solution for
analyzing complex survey data.},
  author = {Sharma, Yash},
  author-email = {yash91sharma@gmail.com},
  booktitle = {2025 IEEE WORLD AI IOT CONGRESS, AIIOT},
  da = {2026-01-12},
  doi = {10.1109/AIIoT65859.2025.11105319},
  editor = {Paul, R},
  keywords = {Topic Modeling; Large Language Models (LLMs); Multi-Agent Systems;
Survey Analysis; Data Enrichment},
  note = {6th WORLD AI IoT Congress-AIIoT-Annual, Seattle, WA, MAY 28-30, 2025},
  pages = {713-718},
  research-areas = {Computer Science},
  times-cited = {0},
  title = {MALTopic: Multi-Agent LLM Topic Modeling Framework},
  type = {Proceedings Paper},
  unique-id = {WOS:001567374700102},
  web-of-science-categories = {Computer Science, Artificial Intelligence; Computer Science,
Interdisciplinary Applications},
  year = {2025}
}

@inproceedings{WOS:001567374700157,
  abstract = {Firefighting remains one of the most perilous professions, demanding
real-time decision-making to address life-threatening hazards such as
chemical exposure, flashovers, backdraft events, and wildfire
propagation. This study harnesses cutting-edge natural language
processing (NLP) and machine learning (ML) techniques to predict these
hazardous scenarios, with a focus on advancing firefighter safety and
situational awareness. We explore the application of advanced NLP
models, including BERT and Doc2Vec, to analyze unstructured data from
authoritative sources like the National Institute of Standards and
Technology (NIST). Key resources such as the Emberometer for wildfire
spread prediction, P-Flash for flashover modeling, and assessments of
PFAS prevalence in firefighter gear are utilized to extract critical
risk indicators. Comparative results demonstrate that BERT significantly
outperforms Doc2Vec in accuracy, context sensitivity, and
interpretability, making it ideal for high-stakes applications. This
research contributes to the development of robust, real-time predictive
models, offering transformative insights into hazard detection and
paving the way for enhanced safety measures in firefighting operations.},
