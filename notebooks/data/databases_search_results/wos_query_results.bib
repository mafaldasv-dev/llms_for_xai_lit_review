@inproceedings{WOS:001446153505036,
  abstract = {Learning graph representations of brain networks aims to facilitate a
deeper understanding of the brain's functional organizational patterns
by developing data-driven algorithms on graph structures, thereby
advancing neuroscience. Recently, deep learning models for brain
networks based on graph neural networks (GNN) have emerged and become
predominant in several tasks of brain functional analysis. Despite the
significant successes of graph representation learning in brain
networks, there remains a gap in dynamically modeling brain networks as
they change over time. Inspired by state space modeling (SSM) in large
language models, particularly Mamba, we introduce brain graph Mamba
(Brain-GM) for dynamic brain graph representation learning.
