@article{Mohanty2025,
  abbrev_source_title = {PeerJ Comput. Sci.},
  abstract = {Multi-disease conditions strain the body’s defenses, complicating recovery and increasing mortality risk. Therefore, effective concurrent prevention of multiple diseases is essential for mitigating complications and improving overall well-being. Explainable artificial intelligence (XAI) with an advanced multimodal large language model (LLM) can create an interactive system enabling the general public to engage in natural language without any specialized knowledge prerequisites. Counterfactual explanation, an XAI method, offers valuable insights by suggesting adjustments to patient features to minimize disease risks. However, addressing multiple diseases simultaneously poses challenging barriers. This article proposes an interactive multi-disease prevention system that uses Google Gemini Pro, a multimodal LLM, and a non-dominated sorting genetic algorithm, namely NSGA-II, to overcome such problems. This system recommends changes in feature values to concurrently minimize the risk of diseases such as heart attacks and diabetes. The system facilitates personalized feature value selection, significantly reducing disease attack probabilities to as low as possible. Such an approach holds the potential to simultaneously address the unresolved issue of preventing and managing multiple diseases for the general public. © 2025 Mohanty et al.},
  affiliations = {Department of Computer Science and Engineering, National Institute of Technology, Meghalaya, Shillong, India; Department of Computer Science, Rijal Alma’a, King Khalid University, Abha, Saudi Arabia; School of Computer Applications, KIIT Deemed to be University, Odisha, Bhubaneswar, India; Department of Computer Science and Engineering, VIT-AP University, Beside AP Secretariat Amaravati, Andhra Pradesh, India; Biomedical Sensors & Systems Lab, The University of Memphis, Memphis, TN, United States; Electrical and Computer Engineering Department, The University of Memphis, Memphis, TN, United States},
