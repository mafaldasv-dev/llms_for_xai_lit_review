  doi = {10.1080/01691864.2024.2415995},
  issn = {01691864},
  journal = {Advanced Robotics},
  keywords = {Adversarial machine learning; Chatbots; Reinforcement learning; Robots; Decision-making process; Decisions makings; Explainability; Interpretability; Language model; Offline; Offline reinforcement learning; Reachability; Reinforcement learnings; World model; Markov processes},
  language = {English},
