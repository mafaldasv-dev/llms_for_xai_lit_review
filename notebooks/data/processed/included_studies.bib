  keywords = {Interactive computer systems; Latent semantic analysis; Machine learning; Deep generative model; Explainable ai; Generative model; High quality; Inductive bias; Language model; Latent representation; Latent variable; Multi-modal; Multimodal large language model; Learning systems},
