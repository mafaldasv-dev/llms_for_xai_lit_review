  issn = {15604292},
  journal = {International Journal of Artificial Intelligence in Education},
  keywords = {Computational linguistics; Cutting tools; Machine learning; Modeling languages; Risk assessment; ChatGPT; Counterfactuals; Explainable machine learning; Interpretable machine learning; Language model; Large language model; Learner intervention support; Learning analytic; Machine-learning; Prescriptive analytic; Prompt engineering; What-if modeling; Predictive analytics},
