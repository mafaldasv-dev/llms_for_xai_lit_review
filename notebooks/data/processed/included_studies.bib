  isbn = {979-835038622-6},
  journal = {Proceedings - 2024 IEEE International Conference on Bioinformatics and Biomedicine, BIBM 2024},
  keywords = {Decision support systems; Natural language processing systems; Problem oriented languages; Argumentation schemes; Clinical decision; Clinical decision support; Clinical reasoning; Cognitive process; Explainable AI; Language model; Large language model; Multiagent systems (MASs); Natural languages; Multi agent systems},
  language = {English},
