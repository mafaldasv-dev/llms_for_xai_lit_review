  doi = {10.7717/peerj-cs.2911},
  issn = {23765992},
  journal = {PeerJ Computer Science},
  keywords = {Deep learning; Speech enhancement; Speech recognition; Automated solutions; Hate speech; Language model; Large language model; Moderation methods; Rationale extraction; Social media; Social-networking; Speech detection; User-generated; Tweets},
  language = {English},
