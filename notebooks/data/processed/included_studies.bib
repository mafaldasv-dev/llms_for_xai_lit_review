@conference{Zhao20254390,
  abbrev_source_title = {CIKM - Proc. ACM Int. Conf. Info. Knowl. Manage.},
  abstract = {Providing explanations to justify recommendations enhances user satisfaction and trust. Despite significant research on explanation generation methods, evaluating their quality remains a critical yet under-explored challenge. Although large language models (LLMs) have been used for automated evaluation of explanations, existing approaches fail to account for the highly personalized na- ture of explanation assessment, where user judgments towards the same explanations vary significantly. To address this, we pro- pose MAML+PEFT method that combines Model-Agnostic Meta- Learning (MAML) with LoRA-based parameter-efficient tuning to adapt LLMs for personalized explanation evaluation. Building on this, we introduce TSA-MAML (Task Similarity Aware MAML)+PEFT, which clusters users based on their estimated optimal model param- eters and learns group-specific meta models by leveraging implicit group distributions of user preferences. Experiments on synthetic and human-annotated datasets demonstrate superior alignment of MAML-based methods with human ratings in both generalization and few-shot adaptation settings. Additionally, we examine the cor- relation of MAML-based LLM-simulated human ratings with real online user behaviors on a large-scale recommendation platform, demonstrating the practical utility of our methods for real-world explainable recommendation systems.  © 2025 ACM. },
  affiliations = {Gaoling School of Artificial Intelligence, Renmin University of China, Beijing, China; Meituan, Beijing, China},
  author = {Zhao, Yurou and Zhang, Yingfei and Zhou, Quan and Zhang, Shuang and Lin, Wei and Mao, Jiaxin},
  author_keywords = {evaluation of explanations for recommendation; llms-as-judges; maml; personalized llm},
  correspondence_address = {J. Mao; Gaoling School of Artificial Intelligence, Renmin University of China, Beijing, China; email: maojiaxin@gmail.com},
  doi = {10.1145/3746252.3761020},
  isbn = {979-840072040-6},
  journal = {CIKM 2025 - Proceedings of the 34th ACM International Conference on Information and Knowledge Management},
  keywords = {Behavioral research; Human engineering; Recommender systems; Automated evaluation; Evaluation of explanation for recommendation; Generation method; Language model; Llms-as-judge; Maml; Meta-learning approach; Metalearning; Personalized llm; Users' satisfactions; Online systems},
  language = {English},
  note = {Cited by: 0; Conference name: 34th ACM International Conference on Information and Knowledge Management, CIKM 2025; Conference sponsors: ACM SIGIR; ACM SIGWEB; Conference code: 214495; Conference date: 10 November 2025 through 14 November 2025},
  pages = {4390 - 4400},
  publication_stage = {Final},
  publisher = {Association for Computing Machinery, Inc},
  source = {Scopus},
  title = {Adapting LLMs for Personalized Evaluation of Explanations for Recommendations: A Meta-Learning Approach based on MAML},
  type = {Conference paper},
  url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105023141892&doi=10.1145%2F3746252.3761020&partnerID=40&md5=27b98c0c0b3551a1ced5a56cf0b01ab1},
