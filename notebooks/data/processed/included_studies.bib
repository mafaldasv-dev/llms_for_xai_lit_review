  author = {Trigg, Lena and Morgan, Brandon and Stringer, Alexander and Schley, Lacey and Hougen, Dean F.},
  author_keywords = {Deep Reinforcement Learning; Explainable AI; Large Language Models; SHAP; UAV},
  coden = {ADACF},
