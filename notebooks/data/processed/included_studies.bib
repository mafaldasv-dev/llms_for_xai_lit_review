  issn = {01679236},
  journal = {Decision Support Systems},
  keywords = {'current; Counterfactual explanation; Counterfactuals; Explainable AI; Language model; Large language model; SHAP; Tabular data; Users' experiences; Xaistory},
  language = {English},
